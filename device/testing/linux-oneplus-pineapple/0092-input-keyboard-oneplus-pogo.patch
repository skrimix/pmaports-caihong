+
+#define POGO_KEY(usage, key)	{ KE_KEY, POGO_KEY_SCAN(usage), { key } }
+#define POGO_CONSUMER(usage, key) { KE_KEY, POGO_CONSUMER_SCAN(usage), { key } }
