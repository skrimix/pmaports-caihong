 	/* close mute */
-	if (!aw88261->mute_st)
-		aw88261_dev_mute(aw_dev, false);
+	if (!aw88261->mute_st) {
+		ret = aw88261_dev_mute(aw_dev, false);
+		if (ret)
+			goto sysst_check_fail;
+	}
 
-	/* clear inturrupt */
-	aw88261_dev_clear_int_status(aw_dev);
+	/* clear interrupt */
+	ret = aw88261_dev_clear_int_status(aw_dev);
+	if (ret)
+		goto sysst_check_fail;
 	aw_dev->status = AW88261_DEV_PW_ON;
 
 	return 0;
 
 sysst_check_fail:
+	regmap_update_bits(aw_dev->regmap, AW88261_SYSCTRL_REG, AW88261_SHUTDOWN_BITS, AW88261_SHUTDOWN_BITS);
 	aw88261_dev_i2s_tx_enable(aw_dev, false);
 	aw88261_dev_clear_int_status(aw_dev);
 	aw88261_dev_amppd(aw_dev, true);
@@ -562,31 +640,27 @@ static int aw88261_dev_start(struct aw88261 *aw88261)
 
 static int aw88261_dev_stop(struct aw_device *aw_dev)
 {
-	if (aw_dev->status == AW88261_DEV_PW_OFF) {
-		dev_info(aw_dev->dev, "already power off");
-		return 0;
-	}
-
-	aw_dev->status = AW88261_DEV_PW_OFF;
-
-	/* clear inturrupt */
-	aw88261_dev_clear_int_status(aw_dev);
-
-	aw88261_dev_uls_hmute(aw_dev, true);
-	/* set mute */
-	aw88261_dev_mute(aw_dev, true);
-
-	/* close tx feedback */
-	aw88261_dev_i2s_tx_enable(aw_dev, false);
+	int ret = 0, err;
+
+	/* Attempt every shutdown operation, including after a partial start. */
+	err = aw88261_dev_mute(aw_dev, true);
+	if (!ret)
+		ret = err;
+	err = aw88261_dev_uls_hmute(aw_dev, true);
+	if (!ret)
+		ret = err;
+	err = aw88261_dev_i2s_tx_enable(aw_dev, false);
+	if (!ret)
+		ret = err;
 	usleep_range(AW88261_1000_US, AW88261_1000_US + 100);
-
-	/* enable amppd */
-	aw88261_dev_amppd(aw_dev, true);
-
-	/* set power down */
-	aw88261_dev_pwd(aw_dev, true);
-
-	return 0;
+	err = aw88261_dev_amppd(aw_dev, true);
+	if (!ret)
+		ret = err;
+	err = aw88261_dev_pwd(aw_dev, true);
+	if (!ret)
+		ret = err;
+	aw_dev->status = AW88261_DEV_PW_OFF;
+	return ret;
 }
 
