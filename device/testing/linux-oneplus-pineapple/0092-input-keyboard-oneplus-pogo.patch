+#define POGO_HDR_LEN			5
+#define POGO_TRAILER_LEN		3
+#define POGO_FRAME_MAX			(POGO_HDR_LEN + 255 + POGO_TRAILER_LEN)
+
+#define POGO_ADDR_KEYBOARD		0xa1
+#define POGO_ADDR_HOST			0xa2
+
+#define POGO_CRC_POLY			0x8005
+#define POGO_CRC_INIT			0xc596
+
+#define POGO_CMD_KEYBOARD		0x01
+#define POGO_CMD_CONSUMER		0x02
+#define POGO_CMD_TOUCHPAD		0x03
