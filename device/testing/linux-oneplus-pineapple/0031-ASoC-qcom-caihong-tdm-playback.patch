 }
 
+static int q6tdm_set_tdm_slot(struct snd_soc_dai *dai, unsigned int tx_mask,
+			    unsigned int rx_mask, int slots, int slot_width)
+{
+	struct q6apm_lpass_dai_data *data = dev_get_drvdata(dai->dev);
+	struct audioreach_module_config *cfg = &data->module_config[dai->id];
+
+	/* RX ports have even IDs. Only playback is implemented. */
+	if (dai->id & 1 || tx_mask || !rx_mask || slots < 1 || slots > 32 ||
+	    (slots < 32 && rx_mask >> slots) ||
+	    (slot_width != 16 && slot_width != 32))
+		return -EINVAL;
+
+	cfg->tdm_slot_mask = rx_mask;
+	cfg->tdm_slots = slots;
+	cfg->tdm_slot_width = slot_width;
+	return 0;
+}
+
+static const struct snd_soc_dai_ops q6tdm_ops = {
+	.prepare = q6apm_lpass_dai_prepare,
+	.startup = q6apm_lpass_dai_startup,
+	.shutdown = q6apm_lpass_dai_shutdown,
+	.hw_params = q6dma_hw_params,
+	.set_fmt = q6i2s_set_fmt,
+	.set_tdm_slot = q6tdm_set_tdm_slot,
+	.trigger = q6apm_lpass_dai_trigger,
+};
+
 static const struct snd_soc_dai_ops q6dma_ops = {
 	.prepare	= q6apm_lpass_dai_prepare,
 	.startup	= q6apm_lpass_dai_startup,
@@ -313,6 +341,7 @@
 
 	memset(&cfg, 0, sizeof(cfg));
 	cfg.q6i2s_ops = &q6i2s_ops;
+	cfg.q6tdm_ops = &q6tdm_ops;
 	cfg.q6dma_ops = &q6dma_ops;
 	cfg.q6hdmi_ops = &q6hdmi_ops;
 	dais = q6dsp_audio_ports_set_config(dev, &cfg, &num_dais);
