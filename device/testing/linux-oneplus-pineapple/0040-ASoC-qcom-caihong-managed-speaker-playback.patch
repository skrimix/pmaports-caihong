+/* dev is an APM DAI device, whose parent owns the APM service. */
+int q6apm_module_param(struct device *dev, u32 iid, u32 id, void *data,
+		      size_t size, bool read)
+{
+	struct q6apm *apm = dev_get_drvdata(dev->parent);
+	struct apm_module_param_data *param;
+	struct gpr_pkt *pkt;
+	unsigned long flags;
+	int ret;
+
+	if (!apm || !size || size > sizeof(apm->param_reply) || size % 4)
+		return -EINVAL;
+	pkt = audioreach_alloc_apm_cmd_pkt(sizeof(*param) + ALIGN(size, 8),
+			read ? APM_CMD_GET_CFG : APM_CMD_SET_CFG, 0);
+	if (IS_ERR(pkt))
+		return PTR_ERR(pkt);
+	param = (void *)pkt + GPR_HDR_SIZE + APM_CMD_HDR_SIZE;
+	param->module_instance_id = iid;
+	param->param_id = id;
+	param->param_size = size;
+	memcpy(param + 1, data, size);
+
+	mutex_lock(&apm->cmd_lock);
+	reinit_completion(&apm->param_done);
+	spin_lock_irqsave(&apm->param_lock, flags);
+	/* High-bit tokens belong to runtime queries, excluding the DMA token. */
+	apm->param_token = BIT(31) | ((apm->param_token + 1) & 0x3fffffff);
+	pkt->hdr.token = apm->param_token;
+	apm->param_opcode = pkt->hdr.opcode;
+	apm->param_iid = iid;
+	apm->param_id = id;
+	apm->param_size = size;
+	apm->param_error = 0;
+	apm->param_pending = true;
+	spin_unlock_irqrestore(&apm->param_lock, flags);
+
+	ret = gpr_send_pkt(apm->gdev, pkt);
+	if (ret >= 0) {
+		if (ret != pkt->hdr.pkt_size)
+			ret = -EIO;
+		else if (!wait_for_completion_timeout(&apm->param_done, 5 * HZ))
+			ret = -ETIMEDOUT;
+		else
+			ret = 0;
+	}
+	spin_lock_irqsave(&apm->param_lock, flags);
+	apm->param_pending = false;
+	if (!ret) {
+		ret = apm->param_error;
+		if (!ret && read)
+			memcpy(data, apm->param_reply, size);
+	}
+	spin_unlock_irqrestore(&apm->param_lock, flags);
+	mutex_unlock(&apm->cmd_lock);
+	kfree(pkt);
+	return ret;
+}
+EXPORT_SYMBOL_GPL(q6apm_module_param);
