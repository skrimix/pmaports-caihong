Subject: [PATCH] ASoC: qcom: use topology-supplied module configurations

Copy module configuration arrays at their byte size, send them without
the private-data header and let them replace generated defaults. Load
effect widgets and ignore output ports beyond the stored links; the OEM
splitter declares 20.

--- a/sound/soc/qcom/qdsp6/audioreach.c
+++ b/sound/soc/qcom/qdsp6/audioreach.c
@@ -817,7 +817,8 @@ static int audioreach_set_module_config(struct q6apm_graph *graph,
 					const struct audioreach_module *module,
 					const struct audioreach_module_config *cfg)
 {
-	int size = le32_to_cpu(module->data->size);
+	/* The topology size includes the private-data header. */
+	int size = le32_to_cpu(module->data->size) - sizeof(*module->data);
 	void *p;
 
 	struct gpr_pkt *pkt __free(kfree) = audioreach_alloc_apm_cmd_pkt(size, APM_CMD_SET_CFG, 0);
@@ -1318,6 +1319,10 @@ int audioreach_set_media_format(struct q6apm_graph *graph,
 {
 	int rc;
 
+	/* A topology-supplied module configuration replaces generated defaults. */
+	if (module->data)
+		return audioreach_set_module_config(graph, module, cfg);
+
 	switch (module->module_id) {
 	case MODULE_ID_DATA_LOGGING:
 		rc = audioreach_module_enable(graph, module, true);
--- a/sound/soc/qcom/qdsp6/topology.c
+++ b/sound/soc/qcom/qdsp6/topology.c
@@ -317,13 +317,11 @@ audioreach_get_module_priv_data(const struct snd_soc_tplg_private *private)
 		if (le32_to_cpu(mod_array->type) == SND_SOC_AR_TPLG_MODULE_CFG_TYPE) {
 			struct audioreach_module_priv_data *pdata;
 
-			pdata = kzalloc_flex(*pdata, data,
-					     le32_to_cpu(mod_array->size));
+			/* The array size is in bytes and includes this header. */
+			pdata = kmemdup(mod_array, le32_to_cpu(mod_array->size), GFP_KERNEL);
 			if (!pdata)
 				return ERR_PTR(-ENOMEM);
 
-			memcpy(pdata, ((u8 *)private->data + sz), struct_size(pdata, data,
-						le32_to_cpu(mod_array->size)));
 			return pdata;
 		}
 
@@ -573,7 +571,8 @@ static struct audioreach_module *audioreach_parse_common_tokens(struct q6apm *ap
 		mod->max_ip_port = max_ip_port;
 		mod->max_op_port = max_op_port;
 		mod->src_mod_inst_id = src_mod_inst_id;
-		for (pn = 0; pn < mod->max_op_port; pn++) {
+		/* Splitters can have more output ports than stored links. */
+		for (pn = 0; pn < AR_MAX_MOD_LINKS && pn < mod->max_op_port; pn++) {
 			if (src_mod_op_port_id[pn] && dst_mod_inst_id[pn] &&
 			    dst_mod_ip_port_id[pn]) {
 				mod->src_mod_op_port_id[id] = src_mod_op_port_id[pn];
@@ -610,7 +609,14 @@ static int audioreach_widget_load_module_common(struct snd_soc_component *compon
 	if (IS_ERR_OR_NULL(mod))
 		return mod ? PTR_ERR(mod) : -ENODEV;
 
 	mod->data = audioreach_get_module_priv_data(&tplg_w->priv);
+	/* Graph setup uses a non-NULL mod->data; never leave an error pointer. */
+	if (IS_ERR(mod->data)) {
+		int ret = PTR_ERR(mod->data);
+
+		mod->data = NULL;
+		return ret;
+	}
 
 	dobj = &w->dobj;
 	dobj->private = mod;
@@ -929,6 +935,8 @@ static int audioreach_widget_ready(struct snd_soc_component *component,
 	case snd_soc_dapm_buffer:
 		audioreach_widget_load_buffer(component, index, w, tplg_w);
 		break;
+	case snd_soc_dapm_effect:
+		return audioreach_widget_load_module_common(component, index, w, tplg_w);
 	case snd_soc_dapm_mixer:
 		return audioreach_widget_load_mixer(component, index, w, tplg_w);
 	case snd_soc_dapm_pga:
