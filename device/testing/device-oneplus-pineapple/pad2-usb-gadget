#!/bin/sh
set -eu

udc=a600000.usb
gadget=/sys/kernel/config/usb_gadget/g1
test -d "/sys/class/udc/$udc"

# Initramfs may have skipped gadget setup while a peripheral owned the port.
if [ ! -d "$gadget" ]; then
	mkdir "$gadget"
	printf '0x18d1\n' > "$gadget/idVendor"
	printf '0xd001\n' > "$gadget/idProduct"
	mkdir "$gadget/strings/0x409"
	printf 'OnePlus\n' > "$gadget/strings/0x409/manufacturer"
	printf 'OnePlus Pad 2\n' > "$gadget/strings/0x409/product"
	printf 'postmarketOS\n' > "$gadget/strings/0x409/serialnumber"
	mkdir "$gadget/configs/c.1"
	mkdir "$gadget/configs/c.1/strings/0x409"
	printf 'USB network\n' > "$gadget/configs/c.1/strings/0x409/configuration"
fi
cd "$gadget"

# Preserve a complete gadget inherited from initramfs or rebound by the kernel.
bound_udc=$(cat UDC)
if [ -n "$bound_udc" ]; then
	test "$bound_udc" = "$udc"
	if [ -L configs/c.1/ncm.usb0 ]; then
		echo 'USB network already attached'
		exit 0
	fi
	printf '\n' > UDC
fi

mkdir -p functions/ncm.usb0
if [ ! -L configs/c.1/ncm.usb0 ]; then
	ln -s "$gadget/functions/ncm.usb0" configs/c.1/ncm.usb0
fi
# NCM creates usb0 only once the gadget binds to the controller.
printf '%s\n' "$udc" > UDC
ip address replace 172.16.42.1/16 dev usb0
ip link set usb0 up
echo 'USB network attached'
