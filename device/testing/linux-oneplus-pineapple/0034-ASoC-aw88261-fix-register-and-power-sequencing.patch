-	regmap_read(aw_dev->regmap, AW88261_SYSINT_REG, &int_status);
-
-	dev_dbg(aw_dev->dev, "read interrupt reg = 0x%04x", int_status);
+		if (!ret)
+			ret = aw88261_dev_fade_in(aw_dev);
+	}
+	if (ret) {
+		/* Try all mute/power-down bits even after a volume I/O failure. */
+		cleanup = regmap_update_bits(aw_dev->regmap, AW88261_SYSCTRL_REG,
+				AW88261_SHUTDOWN_BITS, AW88261_SHUTDOWN_BITS);
+		if (cleanup)
+			dev_err(aw_dev->dev, "mute/power-down failed: %d", cleanup);
+		aw_dev->status = AW88261_DEV_PW_OFF;
+	}
+	return ret;
+}
+
+static int aw88261_dev_clear_int_status(struct aw_device *aw_dev)
+{
+	unsigned int status;
+	int ret;
+
+	ret = regmap_read(aw_dev->regmap, AW88261_SYSINT_REG, &status);
+	if (ret)
+		return ret;
+	return regmap_read(aw_dev->regmap, AW88261_SYSINT_REG, &status);
