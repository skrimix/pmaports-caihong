 static int aw88261_dev_get_icalk(struct aw_device *aw_dev, int16_t *icalk)
@@ -306,7 +350,7 @@ static int aw88261_dev_get_vcalk(struct aw_device *aw_dev, int16_t *vcalk)
 
 	reg_vcalk = (reg_vcalk >> AW88261_VCALK_SHIFT) & (reg_vcalkl >> AW88261_VCALKL_SHIFT);
 
-	if (reg_vcalk & AW88261_EF_VSN_GESLP_SIGN_MASK)
+	if (reg_vcalk & (~AW88261_EF_VSN_GESLP_SIGN_MASK))
 		reg_vcalk = reg_vcalk | (~AW88261_EF_VSN_GESLP_NEG);
 	*vcalk = (int16_t)reg_vcalk;
 
@@ -354,8 +398,8 @@ static int aw88261_dev_reg_update(struct aw88261 *aw88261,
 	u16 reg_val;
 	u8 reg_addr;
 
-	if (!len || !data) {
-		dev_err(aw_dev->dev, "reg data is null or len is 0");
+	if (!len || !data || len % 4) {
+		dev_err(aw_dev->dev, "invalid register profile data or length");
 		return -EINVAL;
 	}
 
@@ -375,7 +419,7 @@ static int aw88261_dev_reg_update(struct aw88261 *aw88261,
 			aw88261->amppd_st = reg_val & (~AW88261_AMPPD_MASK);
 			ret = regmap_read(aw_dev->regmap, reg_addr, &read_val);
 			if (ret)
-				break;
+				return ret;
 
 			/* keep all three bits from current hw status */
 			read_val &= (~AW88261_AMPPD_MASK) | (~AW88261_PWDN_MASK) |
@@ -389,6 +433,7 @@ static int aw88261_dev_reg_update(struct aw88261 *aw88261,
 		}
 
 		if (reg_addr == AW88261_DBGCTRL_REG) {
+			aw88261->dither_st = reg_val & ~AW88261_DITHER_MASK;
 			efcheck_val = reg_val & (~AW88261_EF_DBMD_MASK);
 			if (efcheck_val == AW88261_OR_VALUE)
 				aw88261->efuse_check = AW88261_EF_OR_CHECK;
@@ -415,7 +460,7 @@ static int aw88261_dev_reg_update(struct aw88261 *aw88261,
 
 		ret = regmap_write(aw_dev->regmap, reg_addr, reg_val);
 		if (ret)
-			break;
+			return ret;
 	}
 
 	ret = aw88261_dev_set_vcalb(aw_dev);
@@ -426,9 +471,7 @@ static int aw88261_dev_reg_update(struct aw88261 *aw88261,
 		vol_desc->ctl_volume = 0;
 
 	/* keep min volume */
-	aw88261_dev_set_volume(aw_dev, vol_desc->mute_volume);
-
-	return ret;
+	return aw88261_dev_set_volume(aw_dev, vol_desc->mute_volume);
 }
 
 static int aw88261_dev_get_prof_name(struct aw_device *aw_dev, int index, char **prof_name)
@@ -507,8 +550,16 @@ static int aw88261_dev_start(struct aw88261 *aw88261)
 		return 0;
 	}
 
+	/* Keep dither off until the amplifier startup checks have passed. */
+	ret = regmap_update_bits(aw_dev->regmap, AW88261_DBGCTRL_REG,
+				~AW88261_DITHER_MASK, 0);
+	if (ret)
+		return ret;
+
 	/* power on */
-	aw88261_dev_pwd(aw_dev, false);
+	ret = aw88261_dev_pwd(aw_dev, false);
+	if (ret)
+		goto sysst_check_fail;
 	usleep_range(AW88261_2000_US, AW88261_2000_US + 10);
 
 	ret = aw88261_dev_configure_syspll(aw88261);
@@ -518,7 +569,9 @@ static int aw88261_dev_start(struct aw88261 *aw88261)
 	}
 
 	/* amppd on */
-	aw88261_dev_amppd(aw_dev, false);
+	ret = aw88261_dev_amppd(aw_dev, false);
+	if (ret)
+		goto sysst_check_fail;
 	usleep_range(AW88261_1000_US, AW88261_1000_US + 50);
 
 	/* check i2s status */
@@ -529,27 +582,52 @@ static int aw88261_dev_start(struct aw88261 *aw88261)
 	}
 
 	/* enable tx feedback */
-	aw88261_dev_i2s_tx_enable(aw_dev, true);
+	ret = aw88261_dev_i2s_tx_enable(aw_dev, true);
+	if (ret)
+		goto sysst_check_fail;
 
-	if (aw88261->amppd_st)
-		aw88261_dev_amppd(aw_dev, true);
+	if (aw88261->amppd_st) {
+		ret = aw88261_dev_amppd(aw_dev, true);
+		if (ret)
+			goto sysst_check_fail;
+	}
 
-	aw88261_reg_force_set(aw88261);
+	ret = aw88261_reg_force_set(aw88261);
+	if (ret)
+		goto sysst_check_fail;
 
 	/* close uls mute */
-	aw88261_dev_uls_hmute(aw_dev, false);
+	ret = aw88261_dev_uls_hmute(aw_dev, false);
+	if (ret)
+		goto sysst_check_fail;
+
+	/* Restore the profile dither setting before unmuting. */
+	if (aw88261->dither_st) {
+		ret = regmap_update_bits(aw_dev->regmap, AW88261_DBGCTRL_REG,
