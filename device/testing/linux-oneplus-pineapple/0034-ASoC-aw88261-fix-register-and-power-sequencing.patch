Subject: [PATCH] ASoC: aw88261: fix register access and power sequencing

Correct PID 2113 feedback and trim fields and propagate profile, volume and
startup I/O failures. Match the OEM dither startup sequence and keep the
event-only DAPM widget NOPM. Shutdown attempts all mute, feedback-disable and
power-down operations, and the status check rejects fault flags.

Keep two behaviors that the 7.3 interface rework dropped for profile-driven
boards: the volume keeps the profile's own attenuation (2.5 dB and 7.5 dB in
the Caihong Music profiles), and the I2S/TDM fields, which the ACF profile
programs per amplifier slot, are only overwritten when the machine driver
called set_fmt or set_tdm_slot.

The register layout and startup order were checked against the pinned OnePlus
AW882xx driver and validated with all six Caihong Music profiles.

diff --git a/sound/soc/codecs/aw88261.c b/sound/soc/codecs/aw88261.c
index b8d06534b..db868bd69 100644
--- a/sound/soc/codecs/aw88261.c
+++ b/sound/soc/codecs/aw88261.c
@@ -29,67 +29,89 @@ static const struct regmap_config aw88261_remap_config = {
 	.val_format_endian = REGMAP_ENDIAN_BIG,
 };
 
-static void aw88261_dev_set_volume(struct aw_device *aw_dev, unsigned int value)
+static int aw88261_dev_set_volume(struct aw_device *aw_dev, unsigned int value)
 {
-	unsigned int volume = min(value, (unsigned int)AW88261_MUTE_VOL);
+	struct aw_volume_desc *desc = &aw_dev->volume_desc;
+	unsigned int volume;
 
-	regmap_update_bits(aw_dev->regmap, AW88261_SYSCTRL2_REG,
-		~AW88261_VOL_MASK, DB_TO_REG_VAL(volume));
+	if (value > AW88261_MUTE_VOL || desc->init_volume > AW88261_MUTE_VOL)
+		return -EINVAL;
+	/* The profile's own attenuation stays below the control value. */
+	volume = min(value + desc->init_volume, (unsigned int)AW88261_MUTE_VOL);
+	return regmap_update_bits(aw_dev->regmap, AW88261_SYSCTRL2_REG,
+				~AW88261_VOL_MASK, DB_TO_REG_VAL(volume));
 }
 
-static void aw88261_dev_i2s_tx_enable(struct aw_device *aw_dev, bool flag)
+static int aw88261_dev_i2s_tx_enable(struct aw_device *aw_dev, bool flag)
 {
 	if (flag)
-		regmap_update_bits(aw_dev->regmap, AW88261_I2SCFG1_REG,
+		return regmap_update_bits(aw_dev->regmap, AW88261_I2SCTRL3_REG,
 			~AW88261_I2STXEN_MASK, AW88261_I2STXEN_ENABLE_VALUE);
 	else
-		regmap_update_bits(aw_dev->regmap, AW88261_I2SCFG1_REG,
+		return regmap_update_bits(aw_dev->regmap, AW88261_I2SCTRL3_REG,
 			~AW88261_I2STXEN_MASK, AW88261_I2STXEN_DISABLE_VALUE);
 }
 
-static void aw88261_dev_pwd(struct aw_device *aw_dev, bool pwd)
