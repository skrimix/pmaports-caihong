maintainer=""
pkgname=ssc-monitor
pkgver=0.1.0
pkgrel=7
pkgdesc="Discover and monitor Qualcomm Snapdragon Sensor Core streams"
url="https://codeberg.org/DylanVanAssche/libssc"
arch="all"
license="GPL-3.0-or-later"
_libssc_version=0.4.4
makedepends="glib-dev libqmi-dev linux-headers protobuf-c-dev"
subpackages="$pkgname-dbg"
source="
	$pkgname-libssc-$_libssc_version.tar.gz::$url/archive/v$_libssc_version.tar.gz
	ssc-monitor.c
	monitor.proto
	test-monitor.c
	README.md
"
builddir="$srcdir/libssc"

build() {
	protoc-c -I data --c_out=. data/ssc-common.proto data/ssc-sensor-suid.proto
	protoc-c -I "$srcdir" --c_out=. "$srcdir/monitor.proto"
	# libssc keeps its client API private, so build its sources in.
	for program in ssc-monitor test-monitor; do
		$CC $CFLAGS $CPPFLAGS -Wall -Wextra -Werror -Wno-unused-parameter \
			-I. -Isrc -I"$srcdir" "$srcdir/$program.c" \
			src/libssc-client.c src/libssc-common.c src/libssc-sensor.c \
			ssc-common.pb-c.c ssc-sensor-suid.pb-c.c monitor.pb-c.c \
			$(pkg-config --cflags --libs qmi-glib gio-2.0 libprotobuf-c) \
			$LDFLAGS -lm -o "$program"
	done
}

check() {
	./test-monitor
	./ssc-monitor --help > /dev/null
	if ./ssc-monitor --all gyro 2>/dev/null; then return 1; fi
	if ./ssc-monitor --rate nan gyro 2>/dev/null; then return 1; fi
	if ./ssc-monitor --probe gyro 2>/dev/null; then return 1; fi
}

package() {
	install -Dm755 ssc-monitor "$pkgdir/usr/bin/ssc-monitor"
	install -Dm644 "$srcdir/README.md" "$pkgdir/usr/share/doc/$pkgname/README.md"
	install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
