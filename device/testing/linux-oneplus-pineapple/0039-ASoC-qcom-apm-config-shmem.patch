Subject: [PATCH] ASoC: qcom: send large APM configurations through shared memory

SET_CFG payloads above the APM's 4 KiB in-band buffers are copied to a
DMA buffer of the PCM DAI device and sent with map/config/unmap. A buffer
the DSP has not unmapped is leaked rather than freed. Unmap replies now
report their own opcode, so their waiters no longer time out.

--- a/sound/soc/qcom/qdsp6/q6apm.c
+++ b/sound/soc/qcom/qdsp6/q6apm.c
@@ -3,6 +3,7 @@
 
 #include <dt-bindings/soc/qcom,gpr.h>
 #include <linux/delay.h>
+#include <linux/dma-mapping.h>
 #include <linux/jiffies.h>
 #include <linux/kernel.h>
 #include <linux/module.h>
@@ -33,8 +34,12 @@ struct apm_graph_mgmt_cmd {
 
 static struct q6apm *g_apm;
 
-int q6apm_send_cmd_sync(struct q6apm *apm, const struct gpr_pkt *pkt,
-			uint32_t rsp_opcode)
+/* The APM service has 4 KiB in-band receive buffers. */
+#define APM_INBAND_MAX		4096
+#define APM_CONFIG_TOKEN	U32_MAX
+
+static int __q6apm_send_cmd_sync(struct q6apm *apm, const struct gpr_pkt *pkt,
+				 uint32_t rsp_opcode)
 {
 	gpr_device_t *gdev = apm->gdev;
 
@@ -42,6 +47,119 @@ int q6apm_send_cmd_sync(struct q6apm *apm, const struct gpr_pkt *pkt,
 					NULL, &apm->wait, pkt, rsp_opcode);
 }
 
+/* Send an oversized SET_CFG payload through shared memory: map, configure, unmap. */
+static int q6apm_send_config_shmem(struct q6apm *apm, const struct gpr_pkt *cfg)
+{
+	u32 size = cfg->hdr.pkt_size - GPR_HDR_SIZE - APM_CMD_HDR_SIZE;
+	size_t buf_size = ALIGN(size, 4096);
+	struct apm_shared_map_region_payload *region;
+	struct apm_cmd_shared_mem_unmap_regions *unmap;
+	struct apm_cmd_shared_mem_map_regions *map;
+	struct apm_cmd_header *cmd;
+	struct platform_device *pdev;
+	struct of_phandle_args args;
+	struct device_node *node;
+	struct gpr_pkt *pkt;
+	bool leak = false;
+	dma_addr_t dma;
+	int ret, err;
+	void *buf;
+	u64 addr;
+
+	/* Use the PCM DMA device and its IOMMU stream, as the PCM buffers do. */
+	node = of_get_compatible_child(apm->dev->of_node, "qcom,q6apm-dais");
+	if (!node)
+		return -ENODEV;
+	pdev = of_find_device_by_node(node);
+	ret = of_parse_phandle_with_fixed_args(node, "iommus", 1, 0, &args);
+	of_node_put(node);
+	if (!ret)
+		of_node_put(args.np);
+	if (!pdev)
+		return -ENODEV;
+	if (ret)
+		goto put_device;
+
+	/* One packet is large enough for the map, SET_CFG and unmap commands. */
+	pkt = audioreach_alloc_apm_pkt(sizeof(*map) + sizeof(*region),
+			APM_CMD_SHARED_MEM_MAP_REGIONS, APM_CONFIG_TOKEN, GPR_APM_MODULE_IID);
+	if (IS_ERR(pkt)) {
+		ret = PTR_ERR(pkt);
+		goto put_device;
+	}
+	buf = dma_alloc_coherent(&pdev->dev, buf_size, &dma, GFP_KERNEL);
+	if (!buf) {
+		ret = -ENOMEM;
+		goto free_pkt;
+	}
+	memcpy(buf, (void *)cfg + GPR_HDR_SIZE + APM_CMD_HDR_SIZE, size);
+	addr = dma | ((u64)(args.args[0] & 0xf) << 32);
+
+	map = (void *)pkt + GPR_HDR_SIZE;
+	map->mem_pool_id = APM_MEMORY_MAP_SHMEM8_4K_POOL;
+	map->num_regions = 1;
+	region = (void *)(map + 1);
+	region->shm_addr_lsw = lower_32_bits(addr);
+	region->shm_addr_msw = upper_32_bits(addr);
+	region->mem_size_bytes = buf_size;
+	ret = __q6apm_send_cmd_sync(apm, pkt, APM_CMD_RSP_SHARED_MEM_MAP_REGIONS);
+	if (ret) {
+		leak = ret == -ETIMEDOUT;
+		goto free_buf;
+	}
+
+	pkt->hdr = cfg->hdr;
+	pkt->hdr.pkt_size = GPR_HDR_SIZE + APM_CMD_HDR_SIZE;
+	cmd = (void *)pkt + GPR_HDR_SIZE;
+	cmd->payload_address_lsw = lower_32_bits(addr);
+	cmd->payload_address_msw = upper_32_bits(addr);
+	cmd->mem_map_handle = apm->config_map_handle;
+	cmd->payload_size = size;
+	ret = __q6apm_send_cmd_sync(apm, pkt, 0);
+	if (ret == -ETIMEDOUT) {
+		leak = true;
+		goto free_buf;
+	}
+
+	pkt->hdr.opcode = APM_CMD_SHARED_MEM_UNMAP_REGIONS;
+	pkt->hdr.token = APM_CONFIG_TOKEN;
+	pkt->hdr.pkt_size = GPR_HDR_SIZE + sizeof(*unmap);
+	unmap = (void *)pkt + GPR_HDR_SIZE;
+	unmap->mem_map_handle = apm->config_map_handle;
+	err = __q6apm_send_cmd_sync(apm, pkt, APM_CMD_SHARED_MEM_UNMAP_REGIONS);
+	leak = err;
+	if (!ret)
+		ret = err;
+
+free_buf:
+	/* The DSP may still use a buffer it has not unmapped; never reuse it. */
+	if (leak)
+		dev_err(apm->dev, "APM config buffer leaked: DSP may still use it\n");
+	else
+		dma_free_coherent(&pdev->dev, buf_size, buf, dma);
+free_pkt:
+	kfree(pkt);
+put_device:
+	put_device(&pdev->dev);
+	return ret;
+}
+
+int q6apm_send_cmd_sync(struct q6apm *apm, const struct gpr_pkt *pkt,
+			uint32_t rsp_opcode)
+{
+	int ret;
+
+	if (pkt->hdr.opcode != APM_CMD_SET_CFG || pkt->hdr.pkt_size <= APM_INBAND_MAX)
+		return __q6apm_send_cmd_sync(apm, pkt, rsp_opcode);
+
+	/* Serialize users of the config map handle. */
+	mutex_lock(&apm->cmd_lock);
+	ret = q6apm_send_config_shmem(apm, pkt);
+	mutex_unlock(&apm->cmd_lock);
+
+	return ret;
+}
+
 static struct audioreach_graph *q6apm_get_audioreach_graph(struct q6apm *apm, uint32_t graph_id)
 {
 	struct audioreach_graph_info *info;
@@ -788,6 +906,7 @@ static int apm_probe(gpr_device_t *gdev)
 	dev_set_drvdata(dev, apm);
 
 	mutex_init(&apm->lock);
+	mutex_init(&apm->cmd_lock);
 	apm->dev = dev;
 	apm->gdev = gdev;
 	init_waitqueue_head(&apm->wait);
@@ -879,12 +998,14 @@ static int apm_callback(const struct gpr_resp_pkt *data, void *priv, int op)
 			wake_up(&apm->wait);
 			break;
 		case APM_CMD_SHARED_MEM_UNMAP_REGIONS:
-			apm->result.opcode = hdr->opcode;
-			apm->result.status = 0;
+			apm->result.opcode = result->opcode;
+			apm->result.status = result->status;
 			rsp = data->payload;
 
 			info = idr_find(&apm->graph_info_idr, hdr->token);
-			if (info)
+			if (hdr->token == APM_CONFIG_TOKEN)
+				apm->config_map_handle = 0;
+			else if (info)
 				info->mem_map_handle = 0;
 			else
 				dev_err(dev, "Error (%d) Processing 0x%08x cmd\n", result->status,
@@ -902,7 +1023,9 @@ static int apm_callback(const struct gpr_resp_pkt *data, void *priv, int op)
 		rsp = data->payload;
 
 		info = idr_find(&apm->graph_info_idr, hdr->token);
-		if (info)
+		if (hdr->token == APM_CONFIG_TOKEN)
+			apm->config_map_handle = rsp->mem_map_handle;
+		else if (info)
 			info->mem_map_handle = rsp->mem_map_handle;
 		else
 			dev_err(dev, "Error (%d) Processing 0x%08x cmd\n", result->status,
--- a/sound/soc/qcom/qdsp6/q6apm.h
+++ b/sound/soc/qcom/qdsp6/q6apm.h
@@ -60,6 +60,7 @@ struct q6apm {
 	struct mutex cmd_lock;
 	struct mutex lock;
 	uint32_t state;
+	uint32_t config_map_handle;
 
 	struct list_head widget_list;
 	struct idr graph_idr;
