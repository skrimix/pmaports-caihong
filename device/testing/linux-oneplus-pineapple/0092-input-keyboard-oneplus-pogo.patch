+#define POGO_BAUD			921600
+
+/*
+ * Frame: 0x55 x 8 | 0xf1 | src | dst | cmd | len | payload | CRC16 (BE) |
+ * 0xfe | 0xaa x 4. The CRC covers the start code up to the payload end.
+ */
