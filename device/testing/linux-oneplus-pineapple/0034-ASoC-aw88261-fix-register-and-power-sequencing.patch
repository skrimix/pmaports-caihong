 }
 
 static int aw88261_dev_get_iis_status(struct aw_device *aw_dev)
@@ -130,6 +152,14 @@ static int aw88261_dev_configure_syspll(struct aw88261 *aw88261)
 	struct aw_device *aw_dev = aw88261->aw_pa;
 	int ret;
 
+	/*
+	 * Boards whose machine driver does not describe the link rely on the
