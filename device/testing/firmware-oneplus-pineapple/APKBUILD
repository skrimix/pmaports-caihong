maintainer=""
pkgname=firmware-oneplus-pineapple
pkgver=1
pkgrel=1
_commit="e5f0b275675db29de8c88972cc5246d89f1c9bce"
pkgdesc="Firmware files for OnePlus pineapple and pineapplep"
url="https://github.com/RubyLegend/firmware-oneplus-pineapple"
arch="aarch64"
depends="linux-firmware-ath12k linux-firmware-qcom wireless-regdb"
license="proprietary"
source="
	$pkgname-$_commit.tar.gz::$url/archive/$_commit.tar.gz 
	0001-gpu-firmware.files
	0002-display-firmware.files
	0003-adsp-cdsp-firmware.files
	0004-wifi-firmware.files
	caihong-bdwlan.elf
	"
options="!check !strip !archcheck !spdx !tracedeps pmb:cross-native"
builddir="$srcdir/firmware-oneplus-pineapple-$_commit"

package() {
	mkdir -p "$pkgdir/lib/firmware/qcom/sm8650/"

	# Installing zap firmware as proprietary
	install -Dm644 "firmware/gen70900_zap.mbn" "$pkgdir/lib/firmware/qcom/gen70900_zap.mbn"
	# Installing display firmware
	install -Dm644 "csot-ppc100hb1-1.fw" "$pkgdir/lib/firmware/csot-ppc100hb1-1.fw"
	# Installing adsp and cdsp firmware files
	install -m644 modem_partition/image/adsp* "$pkgdir/lib/firmware/qcom/sm8650/"
	install -m644 modem_partition/image/cdsp* "$pkgdir/lib/firmware/qcom/sm8650/"

	# The pinned archive has the validated OEM HMT.2.0 firmware. Use the
	# kernel's standard override path to coexist with linux-firmware-ath12k.
	install -Dm644 modem_partition/image/kiwi/amss20.bin \
		"$pkgdir/lib/firmware/updates/ath12k/WCN7850/hw2.0/amss.bin"
	install -Dm644 modem_partition/image/kiwi/phy_ucode20.elf \
		"$pkgdir/lib/firmware/updates/ath12k/WCN7850/hw2.0/m3.bin"
	# Stock ODM etc/wifi/kiwi/bdwlan.elf; the modem board file is different.
	install -Dm644 "$srcdir/caihong-bdwlan.elf" \
		"$pkgdir/lib/firmware/updates/ath12k/WCN7850/hw2.0/board.bin"

	install -Dm644 "$srcdir/0001-gpu-firmware.files" "$pkgdir/usr/share/mkinitfs/files/0001-gpu-firmware.files"
	install -Dm644 "$srcdir/0002-display-firmware.files" "$pkgdir/usr/share/mkinitfs/files/0002-display-firmware.files"
	install -Dm644 "$srcdir/0003-adsp-cdsp-firmware.files" "$pkgdir/usr/share/mkinitfs/files/0003-adsp-cdsp-firmware.files"
	install -Dm644 "$srcdir/0004-wifi-firmware.files" "$pkgdir/usr/share/mkinitfs/files/0004-wifi-firmware.files"
}

