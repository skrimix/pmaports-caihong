+#define POGO_STATUS_HEARTBEAT		0x05
+
+#define POGO_PARAM_LED			0x0d
+#define POGO_PASSTHROUGH_VERSION	0x08
+#define POGO_GENERAL_HOST_SLEEP		0x02
+#define POGO_GENERAL_TOUCHPAD_STATE	0x0c
