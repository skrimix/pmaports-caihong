Subject: [PATCH] ASoC: qcom: expose the secondary TDM bit clock

The Caihong sound card clocks secondary TDM from the internal bit clock.
The Caihong topology supplies the complete TDM endpoint configuration.
diff --git a/sound/soc/qcom/qdsp6/q6prm-clocks.c b/sound/soc/qcom/qdsp6/q6prm-clocks.c
index b4f9abbe0..a907c91b0 100644
--- a/sound/soc/qcom/qdsp6/q6prm-clocks.c
+++ b/sound/soc/qcom/qdsp6/q6prm-clocks.c
@@ -19,6 +19,7 @@
 	}
 
 static const struct q6dsp_clk_init q6prm_clks[] = {
+	Q6PRM_CLK(LPASS_CLK_ID_SEC_TDM_IBIT),
 	Q6PRM_CLK(LPASS_CLK_ID_PRI_MI2S_IBIT),
 	Q6PRM_CLK(LPASS_CLK_ID_PRI_MI2S_EBIT),
 	Q6PRM_CLK(LPASS_CLK_ID_SEC_MI2S_IBIT),
diff --git a/sound/soc/qcom/qdsp6/q6prm.h b/sound/soc/qcom/qdsp6/q6prm.h
index cf619ef65..0bbfeee87 100644
--- a/sound/soc/qcom/qdsp6/q6prm.h
+++ b/sound/soc/qcom/qdsp6/q6prm.h
@@ -127,6 +127,7 @@
 #define Q6PRM_LPASS_CLK_ID_VA_QAIF_IF0_EBIT		0x551
 
 #define Q6PRM_LPASS_CLK_SRC_INTERNAL	1
+#define Q6PRM_LPASS_CLK_ID_SEC_TDM_IBIT	0x202
 #define Q6PRM_LPASS_CLK_ROOT_DEFAULT	0
 #define Q6PRM_HW_CORE_ID_LPASS		1
 #define Q6PRM_HW_CORE_ID_DCODEC		2
