Subject: [PATCH] arm64: dts: qcom: caihong: describe the six-speaker sound card

Caihong has six AW88261s on secondary TDM (GPIO121-124) instead of the
MTP SoundWire speakers. The Caihong machine driver owns their gain and
supply monitoring.

--- a/arch/arm64/boot/dts/qcom/sm8650-oneplus-caihong.dts
+++ b/arch/arm64/boot/dts/qcom/sm8650-oneplus-caihong.dts
@@ -1006,3 +1006,99 @@ wlan_en: wlan-en-state {
 		bias-pull-down;
 	};
 };
+
+/* Caihong uses six AW88261s on secondary TDM, not MTP SoundWire speakers. */
+&{/sound} {
+	compatible = "oneplus,caihong-sndcard";
+	model = "OnePlus-Pad-2";
+	clocks = <&q6prmcc LPASS_CLK_ID_SEC_TDM_IBIT LPASS_CLK_ATTRIBUTE_COUPLE_NO>;
+	clock-names = "tdm-bit";
+	pinctrl-names = "default";
+	pinctrl-0 = <&caihong_tdm_pins>;
+	/delete-property/ audio-routing;
+	/delete-node/ wsa-dai-link;
+
+	secondary-tdm-dai-link {
+		link-name = "Secondary TDM Playback";
+		cpu {
+			sound-dai = <&q6apmbedai SECONDARY_TDM_RX_0>;
+		};
+		codec {
+			sound-dai = <&speaker_amp0>, <&speaker_amp1>,
+				    <&speaker_amp2>, <&speaker_amp3>,
+				    <&speaker_amp5>, <&speaker_amp6>;
+		};
+		platform {
+			sound-dai = <&q6apm>;
+		};
+	};
+};
+
+&swr0 {
+	status = "disabled";
+};
+
+&speaker_amp0 {
+	sound-name-prefix = "Amp0";
+	firmware-name = "qcom/sm8650/oneplus/caihong/aw882xx_acf.bin";
+	awinic,external-monitor;
+};
+
+&speaker_amp1 {
+	sound-name-prefix = "Amp1";
+	firmware-name = "qcom/sm8650/oneplus/caihong/aw882xx_acf.bin";
+	awinic,external-monitor;
+};
+
+&speaker_amp2 {
+	sound-name-prefix = "Amp2";
+	firmware-name = "qcom/sm8650/oneplus/caihong/aw882xx_acf.bin";
+	awinic,external-monitor;
+};
+
+&speaker_amp3 {
+	sound-name-prefix = "Amp3";
+	firmware-name = "qcom/sm8650/oneplus/caihong/aw882xx_acf.bin";
+	awinic,external-monitor;
+};
+
+&speaker_amp5 {
+	sound-name-prefix = "Amp5";
+	firmware-name = "qcom/sm8650/oneplus/caihong/aw882xx_acf.bin";
+	awinic,external-monitor;
+};
+
+&speaker_amp6 {
+	sound-name-prefix = "Amp6";
+	firmware-name = "qcom/sm8650/oneplus/caihong/aw882xx_acf.bin";
+	awinic,external-monitor;
+};
+
+&tlmm {
+	caihong_tdm_pins: caihong-tdm-state {
+		clock-pins {
+			pins = "gpio121";
+			function = "i2s1_sck";
+			drive-strength = <6>;
+			bias-disable;
+		};
+		data-in-pins {
+			pins = "gpio122";
+			function = "i2s1_data0";
+			drive-strength = <6>;
+			bias-disable;
+		};
+		frame-sync-pins {
+			pins = "gpio123";
+			function = "i2s1_ws";
+			drive-strength = <6>;
+			bias-disable;
+		};
+		data-out-pins {
+			pins = "gpio124";
+			function = "i2s1_data1";
+			drive-strength = <6>;
+			bias-pull-down;
+		};
+	};
+};
