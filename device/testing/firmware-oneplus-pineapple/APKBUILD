maintainer=""
pkgname=firmware-oneplus-pineapple
pkgver=1
pkgrel=14
_commit="e5f0b275675db29de8c88972cc5246d89f1c9bce"
pkgdesc="Firmware files for OnePlus pineapple and pineapplep"
url="https://github.com/RubyLegend/firmware-oneplus-pineapple"
arch="aarch64"
depends="linux-firmware-ath12k linux-firmware-qcom wireless-regdb"
license="proprietary"
makedepends="alsa-utils binutils-arm-none-eabi python3"
subpackages="$pkgname-sensors $pkgname-keyboard:keyboard"
source="
	$pkgname-$_commit.tar.gz::$url/archive/$_commit.tar.gz 
	0001-gpu-firmware.files
	0002-display-firmware.files
	0003-adsp-cdsp-firmware.files
	0004-wifi-firmware.files
	caihong-bdwlan.elf
	0005-audio-firmware.files
	caihong-aw882xx_acf.bin
	caihong-topology.tar.gz
	caihong-topology.txt
	caihong-sensors.tar.gz
	caihong-sensors.txt
	kbd-dfu
	kbd-dfu-search_f4.S
	kbd-dfu-build-patch.py
	KA026_A_1.5.2_TP_A_0B.bin
	KA026_A_1.5.7_TP_A_0D.bin
	"
options="!check !strip !archcheck !spdx !tracedeps pmb:cross-native"
builddir="$srcdir/firmware-oneplus-pineapple-$_commit"

build() {
	cd "$srcdir/caihong-topology"
	ALSA_CONFIG_TPLG="$srcdir/caihong-topology" alsatplg -c topology.conf -o OnePlus-Pad-2-tplg.bin

	# Stock 1.5.7 keyboard firmware with Search + touchpad toggle key not
	# toggling the touchpad; patch-s1 is the BLE Model Number marker.
	cd "$srcdir"
	arm-none-eabi-as -o search_f4.o kbd-dfu-search_f4.S
	arm-none-eabi-objcopy -O binary search_f4.o search_f4.bin
	python3 kbd-dfu-build-patch.py KA026_A_1.5.7_TP_A_0D.bin search_f4.bin \
		KA026_A_1.5.7_TP_A_0D-search-f4.bin patch-s1
	python3 kbd-dfu inspect KA026_A_1.5.7_TP_A_0D-search-f4.bin
}

package() {
	mkdir -p "$pkgdir/lib/firmware/qcom/sm8650/"

	# Installing zap firmware as proprietary
	install -Dm644 "firmware/gen70900_zap.mbn" "$pkgdir/lib/firmware/qcom/gen70900_zap.mbn"
	# Installing display firmware
	install -Dm644 "csot-ppc100hb1-1.fw" "$pkgdir/lib/firmware/csot-ppc100hb1-1.fw"
	# Installing adsp and cdsp firmware files
	install -m644 modem_partition/image/adsp* "$pkgdir/lib/firmware/qcom/sm8650/"
	install -m644 modem_partition/image/cdsp* "$pkgdir/lib/firmware/qcom/sm8650/"

	# The pinned archive has the validated OEM HMT.2.0 firmware. Use the
	# kernel's standard override path to coexist with linux-firmware-ath12k.
	install -Dm644 modem_partition/image/kiwi/amss20.bin \
		"$pkgdir/lib/firmware/updates/ath12k/WCN7850/hw2.0/amss.bin"
	install -Dm644 modem_partition/image/kiwi/phy_ucode20.elf \
		"$pkgdir/lib/firmware/updates/ath12k/WCN7850/hw2.0/m3.bin"
	# Stock ODM etc/wifi/kiwi/bdwlan.elf; the modem board file is different.
	install -Dm644 "$srcdir/caihong-bdwlan.elf" \
		"$pkgdir/lib/firmware/updates/ath12k/WCN7850/hw2.0/board.bin"
	# OEM-signed Iris firmware; overrides the linux-firmware-qcom build.
	install -Dm644 "firmware/vpu33_4v.mbn" \
		"$pkgdir/lib/firmware/updates/qcom/vpu/vpu33_p4.mbn"

	# Stock ODM AW88261 profiles, selected by the board audio-channel IDs.
	install -Dm644 "$srcdir/caihong-aw882xx_acf.bin" \
		"$pkgdir/lib/firmware/qcom/sm8650/oneplus/caihong/aw882xx_acf.bin"
	install -Dm644 "$srcdir/caihong-topology/OnePlus-Pad-2-tplg.bin" \
		"$pkgdir/lib/firmware/qcom/caihong/OnePlus-Pad-2-tplg.bin"
	install -Dm644 "$srcdir/caihong-topology.txt" \
		"$pkgdir/usr/share/doc/$pkgname/caihong-topology.txt"
	install -Dm644 "$srcdir/0005-audio-firmware.files" \
		"$pkgdir/usr/share/mkinitfs/files/0005-audio-firmware.files"

	install -Dm644 "$srcdir/0001-gpu-firmware.files" "$pkgdir/usr/share/mkinitfs/files/0001-gpu-firmware.files"
	install -Dm644 "$srcdir/0002-display-firmware.files" "$pkgdir/usr/share/mkinitfs/files/0002-display-firmware.files"
	install -Dm644 "$srcdir/0003-adsp-cdsp-firmware.files" "$pkgdir/usr/share/mkinitfs/files/0003-adsp-cdsp-firmware.files"
	install -Dm644 "$srcdir/0004-wifi-firmware.files" "$pkgdir/usr/share/mkinitfs/files/0004-wifi-firmware.files"
}

sensors() {
	pkgdesc="OnePlus Pad 2 OEM sensor configuration and DSP library"
	depends=""
	mkdir -p "$subpkgdir/usr/share/qcom/caihong/sensors"
	cp -a "$srcdir/caihong-sensors/"* "$subpkgdir/usr/share/qcom/caihong/sensors/"
	# Mainline exposes soc_id/revision, but not these four OEM board fields.
	for field in hw_platform platform_subtype platform_subtype_id platform_version; do
		sed -i "s|/sys/devices/soc0/$field\$|/vendor/etc/sensors/socinfo/$field|" \
			"$subpkgdir/usr/share/qcom/caihong/sensors/vendor/etc/sensors/sns_reg_config"
	done
	install -Dm644 "$srcdir/caihong-sensors.txt" \
		"$subpkgdir/usr/share/doc/$subpkgname/caihong-sensors.txt"
}

keyboard() {
	pkgdesc="OnePlus Pad Pro Keyboard firmware (stock and patched) and kbd-dfu updater"
	depends="bluez python3 py3-dbus py3-gobject3"
	install -Dm755 "$srcdir/kbd-dfu" "$subpkgdir/usr/bin/kbd-dfu"
	for fw in KA026_A_1.5.2_TP_A_0B KA026_A_1.5.7_TP_A_0D KA026_A_1.5.7_TP_A_0D-search-f4; do
		install -Dm644 "$srcdir/$fw.bin" "$subpkgdir/usr/share/kbd-dfu/$fw.bin"
	done
}

