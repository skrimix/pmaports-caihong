Subject: [PATCH] ASoC: qcom: configure Caihong secondary TDM playback

TDM ABI: AudioReach pcm_tdm_api.h. Board format matches the OEM ACDB
PARAM_ID_TDM_INTF_CFG payload: 0/1/1/1/0xff/8/32/0/0/0/0.

--- a/sound/soc/qcom/qdsp6/audioreach.c
+++ b/sound/soc/qcom/qdsp6/audioreach.c
@@ -10,6 +10,7 @@
 #include <sound/pcm_params.h>
 #include <dt-bindings/soc/qcom,gpr.h>
 #include "q6apm.h"
+#include "q6dsp-common.h"
 #include "audioreach.h"
 
 /* SubGraph Config */
@@ -304,6 +305,8 @@
 		ch_map[1] =  PCM_CHANNEL_FR;
 		ch_map[2] =  PCM_CHANNEL_LS;
 		ch_map[3] =  PCM_CHANNEL_RS;
+	} else if (num_channels == 8) {
+		q6dsp_map_channels(ch_map, num_channels);
 	}
 }
 EXPORT_SYMBOL_GPL(audioreach_set_default_channel_mapping);
@@ -974,6 +977,70 @@
 }
 EXPORT_SYMBOL_GPL(audioreach_compr_set_param);
 
+static int audioreach_tdm_set_media_format(struct q6apm_graph *graph,
+					 const struct audioreach_module *module,
+					 const struct audioreach_module_config *cfg)
+{
+	struct apm_module_param_data *param;
+	struct param_id_tdm_intf_cfg *tdm;
+	struct apm_module_hw_ep_mf_cfg *hw;
+	struct apm_module_frame_size_factor_cfg *fs;
+	unsigned int format = cfg->fmt & SND_SOC_DAIFMT_FORMAT_MASK;
+	int tdm_size = ALIGN(APM_MODULE_PARAM_DATA_SIZE + sizeof(*tdm), 8);
+	int size = tdm_size + APM_HW_EP_CFG_PSIZE + APM_FS_CFG_PSIZE;
+	void *p;
+
+	/* Single-lane TDM, with the CPU supplying a non-inverted bit clock. */
+	if ((format != SND_SOC_DAIFMT_DSP_A && format != SND_SOC_DAIFMT_DSP_B) ||
+	    (cfg->fmt & SND_SOC_DAIFMT_CLOCK_PROVIDER_MASK) != SND_SOC_DAIFMT_BP_FP ||
+	    (cfg->fmt & SND_SOC_DAIFMT_INV_MASK) != SND_SOC_DAIFMT_NB_NF ||
+	    !cfg->tdm_slots || cfg->tdm_slots > 32 || !cfg->tdm_slot_mask ||
+	    (cfg->tdm_slots < 32 && cfg->tdm_slot_mask >> cfg->tdm_slots) ||
+	    (cfg->tdm_slot_width != 16 && cfg->tdm_slot_width != 32) ||
+	    cfg->bit_width > cfg->tdm_slot_width ||
+	    cfg->num_channels != hweight32(cfg->tdm_slot_mask))
+		return -EINVAL;
+
+	struct gpr_pkt *pkt __free(kfree) = audioreach_alloc_apm_cmd_pkt(size, APM_CMD_SET_CFG, 0);
+	if (IS_ERR(pkt))
+		return PTR_ERR(pkt);
+
+	p = (void *)pkt + GPR_HDR_SIZE + APM_CMD_HDR_SIZE;
+	param = p;
+	param->module_instance_id = module->instance_id;
+	param->param_id = PARAM_ID_TDM_INTF_CFG;
+	param->param_size = sizeof(*tdm);
+	tdm = p + APM_MODULE_PARAM_DATA_SIZE;
+	tdm->lpaif_type = module->hw_interface_type;
+	tdm->intf_idx = module->hw_interface_idx;
+	tdm->sync_src = 1;
+	tdm->ctrl_data_out_enable = 1;
+	tdm->slot_mask = cfg->tdm_slot_mask;
+	tdm->nslots_per_frame = cfg->tdm_slots;
+	tdm->slot_width = cfg->tdm_slot_width;
+	tdm->sync_mode = 0;
+	tdm->ctrl_invert_sync_pulse = 0;
+	tdm->ctrl_sync_data_delay = format == SND_SOC_DAIFMT_DSP_A;
+
+	p += tdm_size;
+	hw = p;
+	hw->param_data.module_instance_id = module->instance_id;
+	hw->param_data.param_id = PARAM_ID_HW_EP_MF_CFG;
+	hw->param_data.param_size = sizeof(hw->mf);
+	hw->mf.sample_rate = cfg->sample_rate;
+	hw->mf.bit_width = cfg->bit_width;
+	hw->mf.num_channels = cfg->num_channels;
+	hw->mf.data_format = module->data_format;
+
+	fs = p + APM_HW_EP_CFG_PSIZE;
+	fs->param_data.module_instance_id = module->instance_id;
+	fs->param_data.param_id = PARAM_ID_HW_EP_FRAME_SIZE_FACTOR;
+	fs->param_data.param_size = sizeof(fs->frame_size_factor);
+	fs->frame_size_factor = 1;
+
+	return q6apm_send_cmd_sync(graph->apm, pkt, 0);
+}
+
 static int audioreach_i2s_set_media_format(struct q6apm_graph *graph,
 					   const struct audioreach_module *module,
 					   const struct audioreach_module_config *cfg)
@@ -1341,6 +1408,9 @@
 	case MODULE_ID_I2S_SINK:
 		rc = audioreach_i2s_set_media_format(graph, module, cfg);
 		break;
+	case MODULE_ID_TDM_SINK:
+		rc = audioreach_tdm_set_media_format(graph, module, cfg);
+		break;
 	case MODULE_ID_WR_SHARED_MEM_EP:
 		rc = audioreach_shmem_set_media_format(graph, module, cfg);
 		break;
