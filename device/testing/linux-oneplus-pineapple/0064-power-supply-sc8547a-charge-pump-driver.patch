+/* SPDX-License-Identifier: GPL-2.0-only */
+/*
+ * SouthChip SC8547A charge pump control for the OnePlus Pad 2 PPS
+ * controller in qcom_battmgr.
+ */
+#ifndef __LINUX_POWER_SC8547A_H
+#define __LINUX_POWER_SC8547A_H
+
+#include <linux/err.h>
+#include <linux/types.h>
+
+struct device_node;
+struct sc8547a;
+
+/* One pass over the state the PPS controller monitors. */
+struct sc8547a_sample {
+	u8 status;		/* 0x06: switching in bit 2 */
+	u8 ctrl;		/* 0x07: reading it services the watchdog */
+	u8 prot_stat;		/* 0x0e */
+	int vbus_mv;
+	int ibus_ma;
+	int vout_mv;
+	int tdie_dc;		/* tenths of a degree C */
+};
+
+#define SC8547A_SAMPLE_SWITCHING(s)	(!!((s)->status & 0x04))
+
+#if IS_REACHABLE(CONFIG_CHARGER_SC8547A)
+struct sc8547a *sc8547a_get(struct device_node *np);
+void sc8547a_put(struct sc8547a *sc);
+int sc8547a_pps_prepare(struct sc8547a *sc, bool primary);
+int sc8547a_pps_switch(struct sc8547a *sc, bool primary, bool on);
+int sc8547a_pps_restore_ucp(struct sc8547a *sc);
+int sc8547a_pps_stop(struct sc8547a *sc, bool primary);
+int sc8547a_sample(struct sc8547a *sc, struct sc8547a_sample *s);
+int sc8547a_read_flags(struct sc8547a *sc, u8 *flags);
+#else
+static inline struct sc8547a *sc8547a_get(struct device_node *np)
+{
+	return ERR_PTR(-ENODEV);
+}
+static inline void sc8547a_put(struct sc8547a *sc) {}
+static inline int sc8547a_pps_prepare(struct sc8547a *sc, bool primary) { return -ENODEV; }
+static inline int sc8547a_pps_switch(struct sc8547a *sc, bool primary, bool on) { return -ENODEV; }
+static inline int sc8547a_pps_restore_ucp(struct sc8547a *sc) { return -ENODEV; }
+static inline int sc8547a_pps_stop(struct sc8547a *sc, bool primary) { return -ENODEV; }
+static inline int sc8547a_sample(struct sc8547a *sc, struct sc8547a_sample *s) { return -ENODEV; }
+static inline int sc8547a_read_flags(struct sc8547a *sc, u8 *flags) { return -ENODEV; }
+#endif
+
+#endif
