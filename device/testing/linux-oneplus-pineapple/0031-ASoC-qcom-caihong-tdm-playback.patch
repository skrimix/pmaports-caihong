 		audioreach_widget_dma_module_load(mod, mod_array);
 		break;
 	case MODULE_ID_DATA_LOGGING:
--- a/arch/arm64/boot/dts/qcom/sm8650-oneplus-caihong.dts
+++ b/arch/arm64/boot/dts/qcom/sm8650-oneplus-caihong.dts
@@ -2,3 +2,40 @@
 	sound-name-prefix = "Amp6";
 	firmware-name = "qcom/sm8650/oneplus/caihong/aw882xx_acf.bin";
 };
+
+&{/sound} {
+	compatible = "oneplus,caihong-sndcard";
+	clocks = <&q6prmcc LPASS_CLK_ID_SEC_TDM_IBIT LPASS_CLK_ATTRIBUTE_COUPLE_NO>;
+	clock-names = "tdm-bit";
+	pinctrl-names = "default";
+	pinctrl-0 = <&caihong_tdm_pins>;
+};
+
+&tlmm {
+	caihong_tdm_pins: caihong-tdm-state {
+		clock-pins {
+			pins = "gpio121";
+			function = "i2s1_sck";
+			drive-strength = <6>;
+			bias-disable;
+		};
+		data-in-pins {
+			pins = "gpio122";
+			function = "i2s1_data0";
+			drive-strength = <6>;
+			bias-disable;
+		};
+		frame-sync-pins {
+			pins = "gpio123";
+			function = "i2s1_ws";
+			drive-strength = <6>;
+			bias-disable;
+		};
+		data-out-pins {
+			pins = "gpio124";
+			function = "i2s1_data1";
+			drive-strength = <6>;
+			bias-pull-down;
+		};
+	};
+};
