+
+/* Attach detection: consecutive sense line samples */
+#define POGO_DETECT_INTERVAL_MS		20
+#define POGO_DETECT_ATTACHED		6
+#define POGO_DETECT_DETACHED		3
+/* Recheck after the keyboard went silent */
+#define POGO_RECHECK_INTERVAL_MS	50
+#define POGO_RECHECK_ATTACHED		12
+#define POGO_RECHECK_DETACHED		20
+#define POGO_RECHECK_MAX		20
+
+#define POGO_WATCHDOG_MS		100
+/* The keyboard needs about 400 ms to start; stock waits up to 2 s */
+#define POGO_CONNECT_TIMEOUT_MS		2000
+#define POGO_HEARTBEAT_TIMEOUT_MS	500
+/* An asleep keyboard sends no heartbeat until it hears that we woke up */
+#define POGO_RESUME_GRACE_MS		1000
+/* Wake a silent keyboard: it runs on its battery and may still be asleep */
+#define POGO_POWERED_WAKE_MS		500
+#define POGO_SLEEP_SETTLE_MS		1000
+
+#define POGO_TX_SETUP_US		450
