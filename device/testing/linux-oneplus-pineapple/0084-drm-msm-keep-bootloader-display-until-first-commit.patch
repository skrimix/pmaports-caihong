diff --git a/drivers/gpu/drm/msm/msm_drv.h b/drivers/gpu/drm/msm/msm_drv.h
index eb4bbae85..7728cffe0 100644
--- a/drivers/gpu/drm/msm/msm_drv.h
+++ b/drivers/gpu/drm/msm/msm_drv.h
@@ -220,7 +220,8 @@ void msm_crtc_disable_vblank(struct drm_crtc *crtc);
 int msm_register_mmu(struct drm_device *dev, struct msm_mmu *mmu);
 void msm_unregister_mmu(struct drm_device *dev, struct msm_mmu *mmu);
 
-struct drm_gpuvm *msm_kms_init_vm(struct drm_device *dev, struct device *mdss_dev);
+struct drm_gpuvm *msm_kms_init_vm(struct drm_device *dev, struct device *mdss_dev,
+				  const struct resource *splash);
 bool msm_use_mmu(struct drm_device *dev);
 
 int msm_ioctl_gem_submit(struct drm_device *dev, void *data,
@@ -418,9 +419,13 @@ static inline void msm_dpu_unregister(void) {}
 #ifdef CONFIG_DRM_MSM_MDSS
 void msm_mdss_register(void);
 void msm_mdss_unregister(void);
+int msm_mdss_splash_region(struct resource *res);
+void msm_mdss_splash_release(struct device *dev);
 #else
 static inline void msm_mdss_register(void) {}
 static inline void msm_mdss_unregister(void) {}
+static inline int msm_mdss_splash_region(struct resource *res) { return -ENODEV; }
+static inline void msm_mdss_splash_release(struct device *dev) {}
 #endif
 
 #ifdef CONFIG_DEBUG_FS
diff --git a/drivers/gpu/drm/msm/msm_iommu.c b/drivers/gpu/drm/msm/msm_iommu.c
index da6782fca..f80ac8c76 100644
--- a/drivers/gpu/drm/msm/msm_iommu.c
+++ b/drivers/gpu/drm/msm/msm_iommu.c
@@ -732,7 +732,8 @@ static const struct msm_mmu_funcs funcs = {
 		.set_stall = msm_iommu_set_stall,
 };
 
-struct msm_mmu *msm_iommu_new(struct device *dev, unsigned long quirks)
+static struct msm_mmu *__msm_iommu_new(struct device *dev, unsigned long quirks,
+				       const struct resource *splash)
 {
 	struct iommu_domain *domain;
 	struct msm_iommu *iommu;
@@ -771,6 +772,18 @@ struct msm_mmu *msm_iommu_new(struct device *dev, unsigned long quirks)
 		}
 	}
 
+	/*
+	 * A bootloader display may still scan out of its splash buffer. Map
+	 * it 1:1 read-only before the attach switches the stream over to
+	 * this domain; the display driver unmaps it after taking over.
+	 */
+	if (splash) {
+		ret = iommu_map(domain, splash->start, splash->start,
+				resource_size(splash), IOMMU_READ, GFP_KERNEL);
+		if (ret)
+			dev_warn(dev, "failed to map splash buffer: %d\n", ret);
+	}
+
 	ret = iommu_attach_device(iommu->domain, dev);
 	if (ret) {
 		iommu_domain_free(domain);
@@ -781,12 +794,18 @@ struct msm_mmu *msm_iommu_new(struct device *dev, unsigned long quirks)
 	return &iommu->base;
 }
 
-struct msm_mmu *msm_iommu_disp_new(struct device *dev, unsigned long quirks)
+struct msm_mmu *msm_iommu_new(struct device *dev, unsigned long quirks)
+{
+	return __msm_iommu_new(dev, quirks, NULL);
+}
+
+struct msm_mmu *msm_iommu_disp_new(struct device *dev, unsigned long quirks,
+				   const struct resource *splash)
 {
 	struct msm_iommu *iommu;
 	struct msm_mmu *mmu;
 
-	mmu = msm_iommu_new(dev, quirks);
+	mmu = __msm_iommu_new(dev, quirks, splash);
 	if (IS_ERR(mmu))
 		return mmu;
 
diff --git a/drivers/gpu/drm/msm/msm_kms.c b/drivers/gpu/drm/msm/msm_kms.c
index e5d0ea629..4ff0987f8 100644
--- a/drivers/gpu/drm/msm/msm_kms.c
+++ b/drivers/gpu/drm/msm/msm_kms.c
@@ -177,7 +177,8 @@ static int msm_kms_fault_handler(void *arg, unsigned long iova, int flags, void
 	return -ENOSYS;
 }
 
-struct drm_gpuvm *msm_kms_init_vm(struct drm_device *dev, struct device *mdss_dev)
+struct drm_gpuvm *msm_kms_init_vm(struct drm_device *dev, struct device *mdss_dev,
+				  const struct resource *splash)
 {
 	struct drm_gpuvm *vm;
 	struct msm_mmu *mmu;
@@ -185,6 +186,7 @@ struct drm_gpuvm *msm_kms_init_vm(struct drm_device *dev, struct device *mdss_de
 	struct msm_drm_private *priv = dev->dev_private;
 	struct msm_kms *kms = priv->kms;
 	struct device *iommu_dev;
+	u64 va_end = 0x100000000;
 
 	/*
 	 * IOMMUs can be a part of MDSS device tree binding, or the
@@ -199,12 +201,16 @@ struct drm_gpuvm *msm_kms_init_vm(struct drm_device *dev, struct device *mdss_de
 		return ERR_PTR(-ENODEV);
 	}
 
-	mmu = msm_iommu_disp_new(iommu_dev, 0);
+	/* Keep allocations clear of the 1:1 splash mapping */
+	if (splash && splash->start < va_end)
+		va_end = splash->start;
+
+	mmu = msm_iommu_disp_new(iommu_dev, 0, splash);
 	if (IS_ERR(mmu))
 		return ERR_CAST(mmu);
 
 	vm = msm_gem_vm_create(dev, mmu, "mdp_kms",
-			       0x1000, 0x100000000 - 0x1000, true);
+			       0x1000, va_end - 0x1000, true);
 	if (IS_ERR(vm)) {
 		dev_err(mdp_dev, "vm create, error %pe\n", vm);
 		mmu->funcs->destroy(mmu);
diff --git a/drivers/gpu/drm/msm/msm_mdss.c b/drivers/gpu/drm/msm/msm_mdss.c
index 9087c4b29..21fe5124d 100644
--- a/drivers/gpu/drm/msm/msm_mdss.c
+++ b/drivers/gpu/drm/msm/msm_mdss.c
@@ -11,6 +11,7 @@
 #include <linux/irqchip.h>
 #include <linux/irqdesc.h>
 #include <linux/irqchip/chained_irq.h>
+#include <linux/of_address.h>
 #include <linux/of_platform.h>
 #include <linux/platform_device.h>
 #include <linux/pm_runtime.h>
@@ -44,6 +45,8 @@ struct msm_mdss {
 	struct icc_path *mdp_path[2];
 	u32 num_mdp_paths;
 	struct icc_path *reg_bus_path;
+	/* runtime-PM reference keeping a bootloader display running */
+	bool splash_hold;
 };
 
 static int msm_mdss_parse_data_bus_icc_path(struct device *dev,
@@ -362,21 +365,57 @@ static int mdp5_mdss_parse_clock(struct platform_device *pdev, struct clk_bulk_d
 	return num_clocks;
 }
 
+/**
+ * msm_mdss_splash_region() - get the bootloader's splash buffer
+ * @res: the splash_region reservation
+ *
+ * The bootloader keeps its display running only when the DT reserves
+ * /reserved-memory/splash_region, and updates the reservation to the buffer
+ * it scans out of. It powers the display down otherwise.
+ *
+ * Return: 0 if the reservation exists, a negative error code otherwise.
+ */
+int msm_mdss_splash_region(struct resource *res)
+{
+	struct device_node *node;
+	int ret;
+
+	node = of_find_node_by_path("/reserved-memory/splash_region");
+	if (!node)
+		return -ENODEV;
+
+	ret = of_address_to_resource(node, 0, res);
+	of_node_put(node);
+
+	return ret;
+}
+
 static struct msm_mdss *msm_mdss_init(struct platform_device *pdev, bool is_mdp5)
 {
 	const struct msm_mdss_data *mdss_data;
 	struct msm_mdss *msm_mdss;
+	struct resource splash;
+	bool splash_hold;
 	int ret;
 	int irq;
 
-	ret = msm_mdss_reset(&pdev->dev);
-	if (ret)
-		return ERR_PTR(ret);
+	/*
+	 * A reset pulse would blank a running bootloader display; DPU stops
+	 * its pipeline at the first commit instead.
+	 */
+	splash_hold = !is_mdp5 && !msm_mdss_splash_region(&splash);
+	if (!splash_hold) {
+		ret = msm_mdss_reset(&pdev->dev);
+		if (ret)
+			return ERR_PTR(ret);
