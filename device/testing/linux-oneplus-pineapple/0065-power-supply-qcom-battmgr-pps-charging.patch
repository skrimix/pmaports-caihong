+	unsigned int ramp_steps, retries, over_count, abnormal_count, low_count;
+	unsigned int ibat_high_count, ibat_low_count, gauge_hot_count, conn_hot_count;
+	unsigned int stopped_count;
+	struct sc8547a_sample cp_sample[PPS_CP_NUM];
+	const char *result;
+	int result_err;
+};
+
 struct qcom_battmgr {
 	struct device *dev;
 	struct pmic_glink_client *client;
@@ -405,6 +477,8 @@ struct qcom_battmgr {
 	struct work_struct oplus_update_usb_state_work;
 	struct delayed_work oplus_init_work;
 
