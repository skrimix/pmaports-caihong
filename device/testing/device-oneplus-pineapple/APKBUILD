# Reference: <https://postmarketos.org/devicepkg>
maintainer=""
pkgname=device-oneplus-pineapple
pkgdesc="OnePlus Pad 2"
pkgver=1
pkgrel=36
url="https://postmarketos.org"
license="MIT"
arch="aarch64"
options="!check !archcheck"
depends="
	linux-oneplus-pineapple>=7.1-r88
	mkbootimg
	android-tools
	postmarketos-base
	postmarketos-initramfs
	lz4
	msm-firmware-loader
	soc-qcom
	soc-qcom-vulkan
	soc-qcom-gstreamer-systemd
	soc-qcom-qbootctl
	unl0kr-fbforcerefresh
	make-dynpart-mappings
	hexagonrpcd
	i2c-tools
	firmware-oneplus-pineapple
	firmware-oneplus-pineapple-sensors
	fastrpc
	qrtr
	ssc-monitor
	alsa-ucm-conf
	python3
"
makedepends="devicepkg-dev fastrpc-dev"
subpackages="$pkgname-audio"
source="
	deviceinfo
	initfs.files
	modules-initfs
	caihong.conf
	HiFi.conf
	52-oneplus-pineapple.conf
	pad2-usb-gadget
	pad2-usb-gadget.service
	81-pad2-usb-gadget.rules
	80-oneplus-pineapple.preset
	81-libssc-oneplus-pineapple.rules
	caihong-persist-import
	caihong-persist-import.service
	caihong-sensors.c
	caihong-sensors.service
	caihong-shell-back
	caihong-shell-back.service
	caihong-minidump
	caihong-minidump-save.service
	90-dev-nopasswd
	99-watchdog.conf
"

build() {
	devicepkg_build $startdir $pkgname
	$CC $CFLAGS $CPPFLAGS -Wall -Wextra -Werror "$srcdir/caihong-sensors.c" \
		-o "$srcdir/caihong-sensors" $LDFLAGS -ladsp_default_listener
}

package() {
	devicepkg_package $startdir $pkgname
	install -Dm644 "$srcdir/initfs.files" \
		"$pkgdir/usr/share/mkinitfs/files/00-$pkgname.files"
	install -Dm755 "$srcdir/pad2-usb-gadget" "$pkgdir/usr/libexec/pad2-usb-gadget"
	install -Dm644 "$srcdir/pad2-usb-gadget.service" \
		"$pkgdir/usr/lib/systemd/system/pad2-usb-gadget.service"
	install -Dm644 "$srcdir/81-pad2-usb-gadget.rules" \
		"$pkgdir/usr/lib/udev/rules.d/81-pad2-usb-gadget.rules"
	install -Dm644 "$srcdir/80-oneplus-pineapple.preset" \
		"$pkgdir/usr/lib/systemd/system-preset/80-oneplus-pineapple.preset"
	install -Dm644 "$srcdir/81-libssc-oneplus-pineapple.rules" \
		"$pkgdir/usr/lib/udev/rules.d/81-libssc-oneplus-pineapple.rules"
	install -Dm755 "$srcdir/caihong-persist-import" \
		"$pkgdir/usr/libexec/caihong-persist-import"
	install -Dm644 "$srcdir/caihong-persist-import.service" \
		"$pkgdir/usr/lib/systemd/system/caihong-persist-import.service"
	install -Dm755 "$srcdir/caihong-sensors" "$pkgdir/usr/libexec/caihong-sensors"
	install -Dm644 "$srcdir/caihong-sensors.service" \
		"$pkgdir/usr/lib/systemd/system/caihong-sensors.service"
	install -Dm755 "$srcdir/caihong-shell-back" \
		"$pkgdir/usr/libexec/caihong-shell-back"
	install -Dm644 "$srcdir/caihong-shell-back.service" \
		"$pkgdir/usr/lib/systemd/system/caihong-shell-back.service"
	install -Dm755 "$srcdir/caihong-minidump" "$pkgdir/usr/bin/caihong-minidump"
	install -Dm644 "$srcdir/caihong-minidump-save.service" \
		"$pkgdir/usr/lib/systemd/system/caihong-minidump-save.service"
	install -Dm644 "$srcdir/99-watchdog.conf" \
		"$pkgdir/usr/lib/systemd/system.conf.d/99-oneplus-pineapple-watchdog.conf"
	# DEBUG: passwordless sudo for development; remove before release.
	install -Dm440 "$srcdir/90-dev-nopasswd" \
		"$pkgdir/etc/sudoers.d/90-dev-nopasswd"
	install -Dm644 "$srcdir/caihong.conf" \
		"$pkgdir/usr/share/alsa/ucm2/Qualcomm/caihong/caihong.conf"
	install -Dm644 "$srcdir/HiFi.conf" \
		"$pkgdir/usr/share/alsa/ucm2/Qualcomm/caihong/HiFi.conf"
	mkdir -p "$pkgdir/usr/share/alsa/ucm2/conf.d/caihong"
	ln -s ../../Qualcomm/caihong/caihong.conf \
		"$pkgdir/usr/share/alsa/ucm2/conf.d/caihong/caihong.conf"
	install -Dm644 "$srcdir/52-oneplus-pineapple.conf" \
		"$pkgdir/usr/share/wireplumber/wireplumber.conf.d/52-oneplus-pineapple.conf"
	# Per-unit data stays in Linux state, outside the shared firmware package.
	mkdir -p "$pkgdir/lib/firmware/qcom/caihong"
	ln -s /var/lib/caihong-persist/media/aw_cali.bin \
		"$pkgdir/lib/firmware/qcom/caihong/aw_cali.bin"
	# Sensor registry initialization crashes ADSP without the OEM configuration.
	mkdir -p "$pkgdir/etc/systemd/system"
	ln -s /dev/null "$pkgdir/etc/systemd/system/hexagonrpcd-adsp-sensorspd.service"
}

audio() {
	# PulseAudio is the default backend provider; the speaker setup targets PipeWire.
	install_if="$pkgname=$pkgver-r$pkgrel postmarketos-base-ui-audio"
	depends="postmarketos-base-ui-audio-backend-pipewire"

	mkdir -p "$subpkgdir"
}

