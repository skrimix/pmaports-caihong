+/* The board owns unmute and gain when external supply monitoring is selected.
+ * Always leave normal codec startup muted, including after an XRUN/restart.
+ */
+int aw88261_monitor_sample(struct snd_soc_component *component, unsigned int *raw)
+{
+	struct aw88261 *amp = snd_soc_component_get_drvdata(component);
+	struct aw_device *aw_dev = amp->aw_pa;
+	int ret;
+
+	mutex_lock(&amp->lock);
+	if (!amp->monitor_managed) {
+		ret = -EINVAL;
+		goto out;
+	}
+	if (amp->start_result) {
+		ret = amp->start_result;
+		goto out;
+	}
+	if (aw_dev->status != AW88261_DEV_PW_ON) {
+		ret = -EPIPE;
+		goto out;
+	}
+	ret = aw88261_dev_check_sysst(aw_dev);
+	if (!ret)
+		ret = regmap_read(amp->regmap, AW88261_VBAT_REG, raw);
+out:
+	mutex_unlock(&amp->lock);
+	return ret;
+}
+EXPORT_SYMBOL_GPL(aw88261_monitor_sample);
+
+int aw88261_monitor_apply(struct snd_soc_component *component,
+			 unsigned int ipeak, unsigned int attenuation)
+{
+	struct aw88261 *amp = snd_soc_component_get_drvdata(component);
+	struct aw_device *aw_dev = amp->aw_pa;
+	unsigned int applied;
+	int ret;
+
+	if (attenuation > AW88261_MUTE_VOL || (ipeak & ~AW88261_IPEAK_BITS))
+		return -EINVAL;
+	mutex_lock(&amp->lock);
+	if (!amp->monitor_managed || aw_dev->status != AW88261_DEV_PW_ON) {
+		ret = -EPIPE;
+		goto out;
+	}
+	ret = regmap_update_bits(amp->regmap, AW88261_BSTCTRL2_REG, AW88261_IPEAK_BITS, ipeak);
+	if (!ret)
+		ret = regmap_read(amp->regmap, AW88261_BSTCTRL2_REG, &applied);
+	if (!ret && (applied & AW88261_IPEAK_BITS) != ipeak)
+		ret = -EIO;
+	if (ret)
+		goto out;
+	if (attenuation == AW88261_MUTE_VOL) {
+		ret = aw88261_dev_mute(aw_dev, true);
+		amp->monitor_audible = false;
+	} else if (!amp->monitor_audible) {
+		aw_dev->volume_desc.ctl_volume = attenuation;
+		ret = aw88261_dev_mute(aw_dev, false);
+		amp->monitor_audible = !ret;
+	} else {
+		ret = aw88261_dev_set_volume(aw_dev, attenuation);
+	}
+	if (!ret)
+		aw_dev->volume_desc.ctl_volume = attenuation;
+out:
+	mutex_unlock(&amp->lock);
+	return ret;
+}
+EXPORT_SYMBOL_GPL(aw88261_monitor_apply);
+
+int aw88261_monitor_mute(struct snd_soc_component *component)
+{
+	struct aw88261 *amp = snd_soc_component_get_drvdata(component);
+	int ret;
+
+	mutex_lock(&amp->lock);
+	ret = aw88261_dev_mute(amp->aw_pa, true);
+	amp->monitor_audible = false;
+	amp->aw_pa->volume_desc.ctl_volume = AW88261_MUTE_VOL;
+	mutex_unlock(&amp->lock);
+	return ret;
+}
+EXPORT_SYMBOL_GPL(aw88261_monitor_mute);
+
