Subject: [PATCH] drm/panel: nt36532 - run at 120 Hz

The pen does not respond at 144 Hz; Android drops to 120 Hz while a pen
is connected. Without working mode switching, make the 120 Hz mode (OEM
timing@0 porches, the same hs_rate) the only one. The enable fallback
follows the first mode instead of assuming 144 Hz.
diff --git a/drivers/gpu/drm/panel/panel-novatek-nt36532.c b/drivers/gpu/drm/panel/panel-novatek-nt36532.c
index 8784541..22a1531 100644
--- a/drivers/gpu/drm/panel/panel-novatek-nt36532.c
+++ b/drivers/gpu/drm/panel/panel-novatek-nt36532.c
@@ -445,7 +445,7 @@ static int nt36532_enable(struct drm_panel* panel)
         pinfo->connector->state->crtc && pinfo->connector->state->crtc->state) {
         pinfo->active_vrefresh = drm_mode_vrefresh(&pinfo->connector->state->crtc->state->adjusted_mode);
     } else {
-        pinfo->active_vrefresh = 144; /* Failsafe */
+        pinfo->active_vrefresh = drm_mode_vrefresh(&pinfo->desc->modes[0]); /* Failsafe */
     }
 
     /* The DSI high-speed link is now alive. Safe to send DCS commands. */
@@ -1068,34 +1068,35 @@ static int csot_init_sequence(struct panel_info* pinfo)
 }
 
 static const struct drm_display_mode csot_display_modes[] = {
-    // /* 120 Hz (Preferred Default) - Base Clock */
-    // {
-    //     .flags = 0,
-    //     .name = "3000x2120@120vid",
-    //     .clock = (3000 + 236 + 40 + 200) * (2120 + 26 + 2 + 208) * 120 / 1000,
-    //     .hdisplay = 3000,
-    //     .hsync_start = 3000 + 236,
-    //     .hsync_end = 3000 + 236 + 40,
-    //     .htotal = 3000 + 236 + 40 + 200,
-    //     .vdisplay = 2120,
-    //     .vsync_start = 2120 + 26,
-    //     .vsync_end = 2120 + 26 + 2,
-    //     .vtotal = 2120 + 26 + 2 + 208,
-    // },
-    /* 144 Hz - High Speed Clock (Unique Horizontal Timings) */
+    /* 120 Hz - OEM timing@0. The only mode: the pen does not work at 144 Hz. */
     {
         .flags = 0,
-        .name = "3000x2120@144vid",
-        .clock = (3000 + 114 + 40 + 76) * (2120 + 26 + 2 + 208) * 144 / 1000,
+        .name = "3000x2120@120vid",
+        .clock = (3000 + 236 + 40 + 200) * (2120 + 26 + 2 + 208) * 120 / 1000,
         .hdisplay = 3000,
-        .hsync_start = 3000 + 114,
-        .hsync_end = 3000 + 114 + 40,
-        .htotal = 3000 + 114 + 40 + 76,
+        .hsync_start = 3000 + 236,
+        .hsync_end = 3000 + 236 + 40,
+        .htotal = 3000 + 236 + 40 + 200,
         .vdisplay = 2120,
         .vsync_start = 2120 + 26,
         .vsync_end = 2120 + 26 + 2,
         .vtotal = 2120 + 26 + 2 + 208,
     },
+    /* Without the pen, 144 Hz works, but switching modes is not supported yet. */
+    // /* 144 Hz - High Speed Clock (Unique Horizontal Timings) */
+    // {
+    //     .flags = 0,
+    //     .name = "3000x2120@144vid",
+    //     .clock = (3000 + 114 + 40 + 76) * (2120 + 26 + 2 + 208) * 144 / 1000,
+    //     .hdisplay = 3000,
+    //     .hsync_start = 3000 + 114,
+    //     .hsync_end = 3000 + 114 + 40,
+    //     .htotal = 3000 + 114 + 40 + 76,
+    //     .vdisplay = 2120,
+    //     .vsync_start = 2120 + 26,
+    //     .vsync_end = 2120 + 26 + 2,
