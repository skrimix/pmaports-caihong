--- /dev/null
+++ b/sound/soc/qcom/caihong.c
@@ -0,0 +1,592 @@
+// SPDX-License-Identifier: GPL-2.0
+/* Caihong speaker supply limits, using the stock scene-0 RX/feedback graph. */
+#include <dt-bindings/sound/qcom,q6afe.h>
+#include <linux/clk.h>
+#include <linux/firmware.h>
+#include <linux/module.h>
+#include <linux/platform_device.h>
+#include <sound/pcm_params.h>
+#include <linux/jiffies.h>
+#include <linux/mutex.h>
+#include <linux/workqueue.h>
+#include <sound/soc.h>
+#include <sound/tlv.h>
+#include "../codecs/aw88261.h"
+#include "qdsp6/q6apm.h"
+#include "common.h"
+
+#define CAIHONG_MONITOR_MS 5000
+#define CAIHONG_RX_IID 0x42ce
+#define CAIHONG_CALIBRATION "qcom/caihong/aw_cali.bin"
+#define CAIHONG_RE 0x10013d32
+#define CAIHONG_ROTATION 0x10013d2e
+#define CAIHONG_PARAM_BANK0 0x10013d2a
+#define CAIHONG_VMAX_LEFT 0x10013d17
+#define CAIHONG_WRITE_DATA 0
+#define CAIHONG_READ_DATA 1
+
+struct limit { unsigned int min, max, ipeak, gain; u32 vmax; };
+/* ACF v0.1.1: alpha=1000, one voltage sample, 5000 ms period.
+ * Temperature table disabled. Gaps retain the preceding selected row.
+ */
+static const struct limit limits[] = {
+	{4100, 5000, 0x8000, 0, 0},
+	{3900, 4000, 0x8000, 0, 4293803014U},
+	{3700, 3800, 0x7000, 4, 4292934946U},
+	{3500, 3600, 0x6000, 6, 4292467776U},
+	{0, 3400, 0x3000, 8, 4291718767U},
+};
+static const unsigned int channels[] = {0, 1, 2, 3, 5, 6};
+
+struct caihong_audio {
+	struct snd_soc_pcm_runtime *rtd;
+	struct snd_pcm_substream *substream;
+	struct clk *tdm_clk;
+	struct snd_soc_component *amps[6];
+	struct delayed_work work;
+	struct mutex lock;
+	bool running, active, fault;
+	bool calibration_applied;
+	u32 resistance[4];
+	unsigned int volume;
+	int rows[6];
+	u32 baseline[4];
+	unsigned int applied_volume;
+	unsigned long next_sample;
+};
+
+/* Persist stores four right-aligned, ten-byte decimal milliohm records.
+ * Reject other layouts and values outside the OEM board's 4..30 ohm range.
+ * Never synthesize calibration for the populated channels 5/6.
+ */
+static int caihong_load_calibration(struct caihong_audio *audio)
+{
+	const struct firmware *fw;
+	u32 resistance[4];
+	unsigned int value;
+	int i, j, ret;
+
+	memset(audio->resistance, 0, sizeof(audio->resistance));
+	ret = request_firmware_direct(&fw, CAIHONG_CALIBRATION, audio->rtd->card->dev);
+	if (ret)
+		return ret;
+	ret = -EINVAL;
+	if (fw->size != 40)
+		goto out;
+	for (i = 0; i < ARRAY_SIZE(resistance); i++) {
+		const u8 *record = fw->data + i * 10;
+
+		for (j = 0; j < 10 && record[j] == ' '; j++)
+			;
+		if (j == 10)
+			goto out;
+		value = 0;
+		for (; j < 10; j++) {
+			if (record[j] < '0' || record[j] > '9')
+				goto out;
+			value = value * 10 + record[j] - '0';
+			if (value > 30000)
+				goto out;
+		}
+		if (value < 4000)
+			goto out;
+		resistance[i] = value * 4096 / 1000;
+	}
+	memcpy(audio->resistance, resistance, sizeof(resistance));
+	ret = 0;
+out:
+	release_firmware(fw);
+	return ret;
+}
+
+static int caihong_apply_calibration(struct caihong_audio *audio)
+{
+	struct device *dev = snd_soc_rtd_to_cpu(audio->rtd, 0)->dev;
+	u32 words[8], rotation = 0;
+	int i, ret;
+
+	for (i = 0; i < ARRAY_SIZE(audio->resistance); i++) {
+		if (!audio->resistance[i])
+			return -EINVAL;
+		words[i * 2] = i;
+		words[i * 2 + 1] = audio->resistance[i];
+	}
+	ret = q6apm_module_param(dev, CAIHONG_RX_IID, CAIHONG_RE,
+			       words, sizeof(words), false);
+	if (ret)
+		return ret;
+	ret = q6apm_module_param(dev, CAIHONG_RX_IID, CAIHONG_ROTATION,
+			       &rotation, sizeof(rotation), false);
+	if (ret)
+		return ret;
+	audio->calibration_applied = true;
+	dev_info(audio->rtd->card->dev, "speaker calibration applied: RE indices 0-3, rotation 0\n");
+	return 0;
+}
+
+static int select_limit(unsigned int raw, int previous)
+{
+	unsigned int mv = raw * 6025 / 1023;
+	int i;
+
+	if (raw > 1023 || previous < -1 || previous >= (int)ARRAY_SIZE(limits))
+		return -EINVAL;
+	for (i = 0; i < ARRAY_SIZE(limits); i++)
+		if (mv >= limits[i].min && (previous == -1 || mv <= limits[i].max))
+			return i;
+	return previous;
+}
+
+/* OEM PAL WRITE_DATA then READ_DATA/GET: channel bank and inner parameter.
+ * The getter returns tuning baseline + adjustment. Only 0..3 implement this ABI.
+ */
+static int caihong_vmax(struct caihong_audio *audio, unsigned int channel, u32 value,
+			 u32 *total, const char **operation)
+{
+	struct device *dev = snd_soc_rtd_to_cpu(audio->rtd, 0)->dev;
+	u32 id = CAIHONG_PARAM_BANK0 + channel / 2;
+	u32 words[7] = {CAIHONG_WRITE_DATA, CAIHONG_VMAX_LEFT + channel % 2,
+		       1, 0, 0, 0, value};
+	int ret;
+
+	*operation = "write vmax";
+
+	ret = q6apm_module_param(dev, CAIHONG_RX_IID, id, words, sizeof(words), false);
+	if (ret)
+		return ret;
+	*operation = "select vmax readback";
+	words[0] = CAIHONG_READ_DATA;
+	ret = q6apm_module_param(dev, CAIHONG_RX_IID, id, words, 24, false);
+	if (ret)
+		return ret;
+	*total = 0;
+	*operation = "read vmax";
+	ret = q6apm_module_param(dev, CAIHONG_RX_IID, id, total, sizeof(*total), true);
+	return ret;
+}
+
+/* Called with lock held; attempt every amp even after an I/O failure. */
+static void caihong_mute(struct caihong_audio *audio)
+{
+	int i, ret;
+
+	for (i = 0; i < ARRAY_SIZE(audio->amps); i++) {
+		ret = aw88261_monitor_mute(audio->amps[i]);
+		if (ret) {
+			audio->fault = true;
+			dev_err(audio->rtd->card->dev, "Amp%u mute failed: %d\n", channels[i], ret);
+		}
+	}
+	audio->active = false;
+}
+
+static void caihong_monitor_work(struct work_struct *work)
+{
+	struct caihong_audio *audio = container_of(work, struct caihong_audio, work.work);
+	struct snd_pcm_substream *substream;
+	unsigned int raw, gain, attenuation;
+	unsigned long now = jiffies, flags;
+	const char *operation;
+	int rows[6], i, ret;
+	u32 total;
+
+	mutex_lock(&audio->lock);
+	if (!audio->running || audio->fault)
+		goto out;
+	memcpy(rows, audio->rows, sizeof(rows));
+	if (!audio->active || time_after_eq(now, audio->next_sample)) {
+		/* Supply polling follows the ACF period, not a protection deadline. */
+		for (i = 0; i < ARRAY_SIZE(audio->amps); i++) {
+			operation = "sample supply/status";
+			ret = aw88261_monitor_sample(audio->amps[i], &raw);
+			/* Codec startup is asynchronous and needs the running TDM clock. */
+			if (ret == -EINPROGRESS && !audio->active) {
+				mod_delayed_work(system_dfl_wq, &audio->work, msecs_to_jiffies(20));
+				goto out;
+			}
+			if (ret)
+				goto fault;
+			operation = "select supply limit";
+			rows[i] = select_limit(raw, audio->rows[i]);
+			if (rows[i] < 0) {
+				ret = rows[i];
+				goto fault;
+			}
+		}
+		if (!audio->calibration_applied) {
+			operation = "apply speaker calibration";
+			i = 0;
+			ret = caihong_apply_calibration(audio);
+			if (ret)
+				goto fault;
+		}
+		for (i = 0; i < ARRAY_SIZE(audio->baseline); i++) {
+			operation = "configure DSP vmax";
+			if (!audio->active) {
+				ret = caihong_vmax(audio, channels[i], 0, &audio->baseline[i], &operation);
+				if (ret)
+					goto fault;
+				if (!limits[rows[i]].vmax)
+					continue;
+			} else if (limits[rows[i]].vmax == limits[audio->rows[i]].vmax) {
+				continue;
+			}
+			ret = caihong_vmax(audio, channels[i], limits[rows[i]].vmax, &total, &operation);
+			if (ret)
+				goto fault;
+			operation = "verify DSP vmax";
+			if (total != audio->baseline[i] + limits[rows[i]].vmax) {
+				ret = -EPROTO;
+				goto fault;
+			}
+		}
+		audio->next_sample = now + msecs_to_jiffies(CAIHONG_MONITOR_MS);
+	}
+	/* Finish DSP limits before unmute. Volume-only work uses the cached rows. */
+	for (i = 0; i < ARRAY_SIZE(audio->amps); i++) {
+		if (audio->active && rows[i] == audio->rows[i] &&
+		    audio->volume == audio->applied_volume)
+			continue;
+		operation = "apply current limit/volume";
+		gain = limits[rows[i]].gain;
+		gain = (gain >> 6) * 48 + (gain & 63);
+		/* Honor both user attenuation and the OEM supply-dependent minimum. */
+		attenuation = max((90 - audio->volume) * 8, gain);
+		ret = aw88261_monitor_apply(audio->amps[i], limits[rows[i]].ipeak, attenuation);
+		if (ret)
+			goto fault;
+	}
+	if (!audio->active)
+		dev_dbg(audio->rtd->card->dev, "speaker monitor active: volume %u/90\n", audio->volume);
+	memcpy(audio->rows, rows, sizeof(rows));
+	audio->active = true;
+	audio->applied_volume = audio->volume;
+	mod_delayed_work(system_dfl_wq, &audio->work,
+		time_before(jiffies, audio->next_sample) ? audio->next_sample - jiffies : 0);
+	goto out;
+fault:
+	audio->fault = true;
+	caihong_mute(audio);
+	dev_err(audio->rtd->card->dev, "Amp%u %s failed: %d; speakers muted\n",
+		channels[i], operation, ret);
+	substream = audio->substream;
+	mutex_unlock(&audio->lock);
+
+	/* STOP re-enters the board trigger: never hold the monitor lock here.
+	 * Close joins this work before releasing the frontend. Recheck the fault
+	 * under the stream lock so an old worker cannot stop a restarted stream.
+	 */
+	snd_pcm_stream_lock_irqsave(substream, flags);
+	mutex_lock(&audio->lock);
+	ret = audio->fault && audio->running;
+	mutex_unlock(&audio->lock);
+	if (ret && snd_pcm_running(substream))
+		snd_pcm_stop(substream, SNDRV_PCM_STATE_XRUN);
+	snd_pcm_stream_unlock_irqrestore(substream, flags);
+	return;
+out:
+	mutex_unlock(&audio->lock);
+}
+
+static int caihong_volume_get(struct snd_kcontrol *control, struct snd_ctl_elem_value *value)
+{
+	struct caihong_audio *audio = (void *)control->private_value;
+
+	mutex_lock(&audio->lock);
+	value->value.integer.value[0] = audio->volume;
+	mutex_unlock(&audio->lock);
+	return 0;
+}
+
+static int caihong_volume_put(struct snd_kcontrol *control, struct snd_ctl_elem_value *value)
+{
+	struct caihong_audio *audio = (void *)control->private_value;
+	long volume = value->value.integer.value[0];
+	int changed;
+
+	if (volume < 0 || volume > 90)
+		return -EINVAL;
+	mutex_lock(&audio->lock);
+	changed = audio->volume != volume;
+	audio->volume = volume;
+	if (changed && audio->running && !audio->fault)
+		mod_delayed_work(system_dfl_wq, &audio->work, 0);
+	mutex_unlock(&audio->lock);
+	return changed;
+}
+
+static int caihong_volume_info(struct snd_kcontrol *control, struct snd_ctl_elem_info *info)
+{
+	info->type = SNDRV_CTL_ELEM_TYPE_INTEGER;
+	info->count = 1;
+	info->value.integer.min = 0;
+	info->value.integer.max = 90;
+	return 0;
+}
+
+static int caihong_status_get(struct snd_kcontrol *control, struct snd_ctl_elem_value *value)
+{
+	struct caihong_audio *audio = (void *)control->private_value;
+
+	mutex_lock(&audio->lock);
+	value->value.integer.value[0] = audio->active;
+	value->value.integer.value[1] = audio->fault;
+	mutex_unlock(&audio->lock);
+	return 0;
+}
+
+static int caihong_status_info(struct snd_kcontrol *control, struct snd_ctl_elem_info *info)
+{
+	info->type = SNDRV_CTL_ELEM_TYPE_BOOLEAN;
+	info->count = 2;
+	info->value.integer.min = 0;
+	info->value.integer.max = 1;
+	return 0;
+}
+
+static void caihong_audio_stop(struct caihong_audio *audio)
+{
+	mutex_lock(&audio->lock);
+	audio->running = false;
+	/* The fault worker can re-enter STOP via snd_pcm_stop(). Close joins it. */
+	cancel_delayed_work(&audio->work);
+	caihong_mute(audio);
+	mutex_unlock(&audio->lock);
+}
+
+static int caihong_audio_trigger(struct caihong_audio *audio, int cmd)
+{
+	int i;
+
+	switch (cmd) {
+	case SNDRV_PCM_TRIGGER_START:
+	case SNDRV_PCM_TRIGGER_RESUME:
+	case SNDRV_PCM_TRIGGER_PAUSE_RELEASE:
+		mutex_lock(&audio->lock);
+		if (!audio->substream) {
+			mutex_unlock(&audio->lock);
+			return -ENODEV;
+		}
+		if (!audio->resistance[0]) {
+			mutex_unlock(&audio->lock);
+			return -EINVAL;
+		}
+		audio->active = false;
+		audio->running = true;
+		audio->fault = false;
+		for (i = 0; i < ARRAY_SIZE(audio->rows); i++)
+			audio->rows[i] = -1;
+		mod_delayed_work(system_dfl_wq, &audio->work, msecs_to_jiffies(20));
+		mutex_unlock(&audio->lock);
+		return 0;
+	case SNDRV_PCM_TRIGGER_STOP:
+	case SNDRV_PCM_TRIGGER_SUSPEND:
+	case SNDRV_PCM_TRIGGER_PAUSE_PUSH:
+		caihong_audio_stop(audio);
+		return 0;
+	default:
+		return -EINVAL;
+	}
+}
+
+static const DECLARE_TLV_DB_SCALE(caihong_volume_tlv, -9000, 100, 1);
+
+static int caihong_tdm_init(struct snd_soc_pcm_runtime *rtd)
+{
+	struct caihong_audio *audio = snd_soc_card_get_drvdata(rtd->card);
+	struct snd_soc_dai *cpu_dai = snd_soc_rtd_to_cpu(rtd, 0);
+	struct snd_soc_dai *dai;
+	struct snd_kcontrol_new controls[] = {
+		{ .iface = SNDRV_CTL_ELEM_IFACE_MIXER, .name = "Speaker Playback Volume",
+		  .access = SNDRV_CTL_ELEM_ACCESS_READWRITE | SNDRV_CTL_ELEM_ACCESS_TLV_READ,
+		  .info = caihong_volume_info, .get = caihong_volume_get, .put = caihong_volume_put,
+		  .tlv.p = caihong_volume_tlv },
+		{ .iface = SNDRV_CTL_ELEM_IFACE_MIXER, .name = "Speaker Monitor Status",
+		  .access = SNDRV_CTL_ELEM_ACCESS_READ | SNDRV_CTL_ELEM_ACCESS_VOLATILE,
+		  .info = caihong_status_info, .get = caihong_status_get },
+	};
+	u32 channel;
+	int i, n, ret;
+
+	if (rtd->dai_link->num_codecs != 6)
+		return -EINVAL;
+	audio->rtd = rtd;
+	ret = clk_set_rate(audio->tdm_clk, 48000 * 8 * 32);
+	if (ret)
+		return ret;
+	ret = snd_soc_dai_set_fmt(cpu_dai, SND_SOC_DAIFMT_DSP_B |
+				 SND_SOC_DAIFMT_BP_FP | SND_SOC_DAIFMT_NB_NF);
+	if (ret)
+		return ret;
+	ret = snd_soc_dai_set_tdm_slot(cpu_dai, 0, 0xff, 8, 32);
+	if (ret)
+		return ret;
+	for_each_rtd_codec_dais(rtd, i, dai) {
+		if (!of_property_read_bool(dai->dev->of_node, "awinic,external-monitor") ||
+		    of_property_read_u32(dai->dev->of_node, "awinic,audio-channel", &channel))
+			return -EINVAL;
+		for (n = 0; n < ARRAY_SIZE(channels); n++)
+			if (channel == channels[n])
+				break;
+		if (n == ARRAY_SIZE(channels) || audio->amps[n])
+			return -EINVAL;
+		audio->amps[n] = dai->component;
+	}
+	for (i = 0; i < ARRAY_SIZE(controls); i++)
+		controls[i].private_value = (unsigned long)audio;
+	ret = snd_soc_add_card_controls(rtd->card, controls, ARRAY_SIZE(controls));
+	return ret;
+}
+
+static int caihong_tdm_startup(struct snd_pcm_substream *substream)
+{
+	struct snd_soc_pcm_runtime *rtd = snd_soc_substream_to_rtd(substream);
+	struct caihong_audio *audio = snd_soc_card_get_drvdata(rtd->card);
+
+	return clk_prepare_enable(audio->tdm_clk);
+}
+
+static void caihong_tdm_shutdown(struct snd_pcm_substream *substream)
+{
+	struct snd_soc_pcm_runtime *rtd = snd_soc_substream_to_rtd(substream);
+	struct caihong_audio *audio = snd_soc_card_get_drvdata(rtd->card);
+
+	caihong_audio_stop(audio);
+	cancel_delayed_work_sync(&audio->work);
+	/* The backend graph closes at shutdown, not on STOP/pause/resume. */
+	mutex_lock(&audio->lock);
+	audio->calibration_applied = false;
+	mutex_unlock(&audio->lock);
+	clk_disable_unprepare(audio->tdm_clk);
+}
+
+static int caihong_tdm_trigger(struct snd_pcm_substream *substream, int cmd)
+{
+	struct snd_soc_pcm_runtime *rtd = snd_soc_substream_to_rtd(substream);
+
+	return caihong_audio_trigger(snd_soc_card_get_drvdata(rtd->card), cmd);
+}
+
+static int caihong_tdm_fixup(struct snd_soc_pcm_runtime *rtd,
+			     struct snd_pcm_hw_params *params)
+{
+	struct snd_interval *rate = hw_param_interval(params, SNDRV_PCM_HW_PARAM_RATE);
+	struct snd_interval *channels = hw_param_interval(params, SNDRV_PCM_HW_PARAM_CHANNELS);
+	struct snd_mask *format = hw_param_mask(params, SNDRV_PCM_HW_PARAM_FORMAT);
+
+	rate->min = rate->max = 48000;
+	channels->min = channels->max = 8;
+	snd_mask_none(format);
+	snd_mask_set_format(format, SNDRV_PCM_FORMAT_S32_LE);
+	return 0;
+}
+
+static const struct snd_soc_ops caihong_tdm_ops = {
+	.startup = caihong_tdm_startup,
+	.shutdown = caihong_tdm_shutdown,
+	.trigger = caihong_tdm_trigger,
+};
+
+static int caihong_pcm_startup(struct snd_pcm_substream *substream)
+{
+	struct snd_soc_pcm_runtime *rtd = snd_soc_substream_to_rtd(substream);
+	struct caihong_audio *audio = snd_soc_card_get_drvdata(rtd->card);
+	int ret = 0;
+
+	mutex_lock(&audio->lock);
+	if (audio->substream)
+		ret = -EBUSY;
+	else {
+		/* The imported factory data is fixed for this card lifetime. */
+		if (!audio->resistance[0])
+			ret = caihong_load_calibration(audio);
+		if (ret)
+			dev_err(rtd->card->dev, "speaker calibration %s failed: %d; speakers remain muted\n",
+				CAIHONG_CALIBRATION, ret);
+		else
+			audio->substream = substream;
+	}
+	mutex_unlock(&audio->lock);
+	return ret;
+}
+
+static void caihong_pcm_shutdown(struct snd_pcm_substream *substream)
+{
+	struct snd_soc_pcm_runtime *rtd = snd_soc_substream_to_rtd(substream);
+	struct caihong_audio *audio = snd_soc_card_get_drvdata(rtd->card);
+
+	caihong_audio_stop(audio);
+	cancel_delayed_work_sync(&audio->work);
+	mutex_lock(&audio->lock);
+	audio->substream = NULL;
+	mutex_unlock(&audio->lock);
+}
+
+static const struct snd_soc_ops caihong_pcm_ops = {
+	.startup = caihong_pcm_startup,
+	.shutdown = caihong_pcm_shutdown,
+};
+
+static int caihong_late_probe(struct snd_soc_card *card)
+{
+	struct snd_soc_pcm_runtime *rtd;
+
+	/* The frontend links are created by AudioReach topology during probe. */
+	for_each_card_rtds(card, rtd)
+		if (rtd->dai_link->dynamic)
+			rtd->dai_link->ops = &caihong_pcm_ops;
+	return 0;
+}
+
+static int caihong_probe(struct platform_device *pdev)
+{
+	struct device *dev = &pdev->dev;
+	struct snd_soc_card *card;
+	struct caihong_audio *audio;
+	struct snd_soc_dai_link *link;
+	int i, ret;
+
+	card = devm_kzalloc(dev, sizeof(*card), GFP_KERNEL);
+	audio = devm_kzalloc(dev, sizeof(*audio), GFP_KERNEL);
+	if (!card || !audio)
+		return -ENOMEM;
+	audio->tdm_clk = devm_clk_get(dev, "tdm-bit");
+	if (IS_ERR(audio->tdm_clk))
+		return PTR_ERR(audio->tdm_clk);
+	audio->volume = 60;
+	mutex_init(&audio->lock);
+	INIT_DELAYED_WORK(&audio->work, caihong_monitor_work);
+	card->dev = dev;
+	card->owner = THIS_MODULE;
+	card->driver_name = "caihong";
+	card->late_probe = caihong_late_probe;
+	snd_soc_card_set_drvdata(card, audio);
+	ret = qcom_snd_parse_of(card);
+	if (ret)
+		return ret;
+	for_each_card_prelinks(card, i, link) {
+		if (!link->no_pcm || link->id != SECONDARY_TDM_RX_0)
+			return -EINVAL;
+		link->init = caihong_tdm_init;
+		link->ops = &caihong_tdm_ops;
+		link->be_hw_params_fixup = caihong_tdm_fixup;
+	}
+	return devm_snd_soc_register_card(dev, card);
+}
+
+static const struct of_device_id caihong_match[] = {
+	{ .compatible = "oneplus,caihong-sndcard" },
+	{}
+};
+MODULE_DEVICE_TABLE(of, caihong_match);
+
+static struct platform_driver caihong_driver = {
+	.probe = caihong_probe,
+	.driver = {
+		.name = "snd-caihong",
+		.of_match_table = caihong_match,
+	},
+};
+module_platform_driver(caihong_driver);
+MODULE_DESCRIPTION("OnePlus Pad 2 ASoC machine driver");
+MODULE_LICENSE("GPL");
