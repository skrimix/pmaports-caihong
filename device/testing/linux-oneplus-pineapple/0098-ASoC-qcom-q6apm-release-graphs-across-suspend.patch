-
 static int q6apm_lpass_dai_prepare(struct snd_pcm_substream *substream, struct snd_soc_dai *dai)
 {
 	struct q6apm_lpass_dai_data *dai_data = dev_get_drvdata(dai->dev);
@@ -241,9 +216,10 @@ static int q6apm_lpass_dai_prepare(struct snd_pcm_substream *substream, struct s
 
 	/**
 	 * It is recommend to load DSP with source graph first and then sink
-	 * graph, so sequence for playback and capture will be different
+	 * graph, so sequence for playback and capture will be different.
+	 * System suspend also releases capture graphs.
 	 */
-	if (substream->stream == SNDRV_PCM_STREAM_PLAYBACK && dai_data->graph[dai->id] == NULL) {
+	if (dai_data->graph[dai->id] == NULL) {
 		graph = q6apm_graph_open(dai->dev, NULL, dai->dev, graph_id, substream->stream);
 		if (IS_ERR(graph)) {
 			dev_err(dai->dev, "Failed to open graph (%d)\n", graph_id);
@@ -274,6 +250,40 @@ static int q6apm_lpass_dai_prepare(struct snd_pcm_substream *substream, struct s
 	return rc;
 }
 
+static int q6apm_lpass_dai_trigger(struct snd_pcm_substream *substream, int cmd,
+				   struct snd_soc_dai *dai)
+{
+	struct q6apm_lpass_dai_data *dai_data = dev_get_drvdata(dai->dev);
+	int ret = 0;
+
+	switch (cmd) {
+	case SNDRV_PCM_TRIGGER_START:
+	case SNDRV_PCM_TRIGGER_RESUME:
+	case SNDRV_PCM_TRIGGER_PAUSE_RELEASE:
+		/*
+		 * System suspend released the graph, and DPCM does not prepare
+		 * again a BE that was prepared but not running.
+		 */
+		if (!dai_data->graph[dai->id]) {
+			ret = q6apm_lpass_dai_prepare(substream, dai);
+			if (ret)
+				return ret;
+		}
+		if (!dai_data->is_port_started[dai->id]) {
+			ret = q6apm_graph_start(dai_data->graph[dai->id]);
+			if (ret < 0)
+				dev_err(dai->dev, "Failed to start APM port %d\n", dai->id);
+			else
+				dai_data->is_port_started[dai->id] = true;
+		}
+		break;
+	default:
+		break;
+	}
+
+	return ret;
+}
+
 static int q6apm_lpass_dai_startup(struct snd_pcm_substream *substream, struct snd_soc_dai *dai)
 {
 	struct q6apm_lpass_dai_data *dai_data = dev_get_drvdata(dai->dev);
@@ -445,12 +455,34 @@ static const struct snd_soc_dai_ops q6tdm_ops = {
 	.trigger	= q6apm_lpass_dai_trigger,
 };
 
+/* An open graph keeps the ADSP out of power collapse; prepare opens it again */
+static int q6apm_lpass_dai_suspend(struct snd_soc_component *component)
+{
+	struct q6apm_lpass_dai_data *dai_data = dev_get_drvdata(component->dev);
+	int i;
+
+	for (i = 0; i < APM_PORT_MAX; i++) {
+		if (!dai_data->graph[i])
+			continue;
+
+		if (dai_data->is_port_started[i]) {
+			q6apm_graph_stop(dai_data->graph[i]);
+			dai_data->is_port_started[i] = false;
+		}
+		q6apm_graph_close(dai_data->graph[i]);
+		dai_data->graph[i] = NULL;
+	}
+
+	return 0;
+}
+
 static const struct snd_soc_component_driver q6apm_lpass_dai_component = {
 	.name = "q6apm-be-dai-component",
 	.of_xlate_dai_name = q6dsp_audio_ports_of_xlate_dai_name,
 	.be_pcm_base = AUDIOREACH_BE_PCM_BASE,
 	.use_dai_pcm_id = true,
 	.remove_order   = SND_SOC_COMP_ORDER_FIRST,
+	.suspend = q6apm_lpass_dai_suspend,
 };
 
 static int of_q6apm_parse_dai_data(struct device *dev,
