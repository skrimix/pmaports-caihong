# Forked from Alpine to use skrimix's fix/slot-switching branch.
maintainer="skrimix <skrimix.git@fastmail.org>"
pkgname=qbootctl
pkgver=0.2.2
pkgrel=2
_commit=f5bbc9f6f67da9f5ea09aef7da4049a456ce0550
pkgdesc="Tool for interacting with Android A/B slots"
url="https://github.com/skrimix/qbootctl"
# Only really useful on Qualcomm A/B Android devices
arch="all"
license="GPL-3.0-or-later"
makedepends="
	linux-headers
	meson
	zlib-dev
"
subpackages="$pkgname-openrc $pkgname-systemd"
source="$pkgname-$_commit.tar.gz::https://github.com/skrimix/qbootctl/archive/$_commit.tar.gz
	qbootctl-openrc.initd
	systemd-service.patch
	"
builddir="$srcdir/$pkgname-$_commit"

build() {
	abuild-meson . output
	meson compile -C output
}

check() {
	meson test -C output --print-errorlogs
}

package() {
	DESTDIR="$pkgdir" meson install --no-rebuild -C output

	install -Dm755 "$srcdir/$pkgname-openrc.initd" "$pkgdir/etc/init.d/$pkgname"
}

sha512sums="
