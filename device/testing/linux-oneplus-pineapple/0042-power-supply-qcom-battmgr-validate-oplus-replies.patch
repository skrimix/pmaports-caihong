 #define BATT_POWER_AVG			23
 #define BATT_CHG_CTRL_EN		24
-#define BATT_CHG_CTRL_START_THR		25
-#define BATT_CHG_CTRL_END_THR		26
 
 #define BATTMGR_USB_PROPERTY_GET	0x32
 #define BATTMGR_USB_PROPERTY_SET	0x33
@@ -351,6 +350,11 @@
 
 	int error;
 	struct completion ack;
+	/* Protect the pending request against replies racing with a timeout. */
+	spinlock_t reply_lock;
+	bool request_pending;
+	unsigned int request_opcode;
+	unsigned int request_property;
 
 	bool service_up;
 
@@ -377,22 +381,39 @@
 
 static int qcom_battmgr_request(struct qcom_battmgr *battmgr, void *data, size_t len)
 {
-	unsigned long left;
+	const struct qcom_battmgr_property_request *request = data;
+	const struct pmic_glink_hdr *hdr = data;
+	unsigned long flags, left;
+	unsigned int opcode = le32_to_cpu(hdr->opcode);
 	int ret;
 
+	lockdep_assert_held(&battmgr->lock);
+	spin_lock_irqsave(&battmgr->reply_lock, flags);
 	reinit_completion(&battmgr->ack);
-
-	battmgr->error = 0;
+	battmgr->error = -EINPROGRESS;
+	battmgr->request_opcode = opcode;
+	battmgr->request_property = U32_MAX;
+	if (opcode == BATTMGR_BAT_PROPERTY_GET ||
+	    opcode == BATTMGR_USB_PROPERTY_GET ||
+	    opcode == BATTMGR_USB_PROPERTY_SET ||
+	    opcode == BATTMGR_WLS_PROPERTY_GET)
+		battmgr->request_property = le32_to_cpu(request->property);
+	battmgr->request_pending = true;
+	spin_unlock_irqrestore(&battmgr->reply_lock, flags);
 
 	ret = pmic_glink_send(battmgr->client, data, len);
 	if (ret < 0)
-		return ret;
+		goto out;
 
 	left = wait_for_completion_timeout(&battmgr->ack, HZ);
-	if (!left)
-		return -ETIMEDOUT;
-
-	return battmgr->error;
+	ret = left ? 0 : -ETIMEDOUT;
+out:
+	spin_lock_irqsave(&battmgr->reply_lock, flags);
+	battmgr->request_pending = false;
+	if (!ret)
+		ret = battmgr->error;
+	spin_unlock_irqrestore(&battmgr->reply_lock, flags);
+	return ret;
 }
 
