--- a/sound/soc/qcom/qdsp6/audioreach.c
+++ b/sound/soc/qcom/qdsp6/audioreach.c
@@ -817,11 +817,36 @@
 }
 
 static int audioreach_set_module_config(struct q6apm_graph *graph,
-					const struct audioreach_module *module,
-					const struct audioreach_module_config *cfg)
-{
-	int size = le32_to_cpu(module->data->size);
+					const struct audioreach_module *module)
+{
+	const struct audioreach_module_priv_data *data = module->data;
+	const struct apm_module_param_data *param;
+	u32 size, remaining, param_size;
+	const u8 *record;
 	void *p;
+
+	if (!data || le32_to_cpu(data->size) <= sizeof(*data))
+		return -EINVAL;
+	/* The topology size includes its header; the APM payload does not. */
+	size = le32_to_cpu(data->size) - sizeof(*data);
+	if (size > 0xffffff - GPR_HDR_SIZE - APM_CMD_HDR_SIZE)
+		return -E2BIG;
+	remaining = size;
+	record = (const void *)data->data;
+	while (remaining) {
+		if (remaining < sizeof(*param))
+			return -EINVAL;
+		param = (const void *)record;
+		param_size = le32_to_cpu(param->param_size);
+		if (le32_to_cpu(param->module_instance_id) != module->instance_id ||
+		    !param->param_id || param->error_code ||
+		    param_size > remaining - sizeof(*param) ||
+		    ALIGN(param_size, 8) > remaining - sizeof(*param))
+			return -EINVAL;
+		param_size = sizeof(*param) + ALIGN(param_size, 8);
+		record += param_size;
+		remaining -= param_size;
+	}
 
 	struct gpr_pkt *pkt __free(kfree) = audioreach_alloc_apm_cmd_pkt(size, APM_CMD_SET_CFG, 0);
 	if (IS_ERR(pkt))
@@ -829,7 +854,7 @@
 
 	p = (void *)pkt + GPR_HDR_SIZE + APM_CMD_HDR_SIZE;
 
-	memcpy(p, module->data->data, size);
+	memcpy(p, data->data, size);
 
 	return q6apm_send_cmd_sync(graph->apm, pkt, 0);
 }
