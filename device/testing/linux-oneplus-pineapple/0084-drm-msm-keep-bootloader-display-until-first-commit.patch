 	}
 	mdelay(16);
 
-	vm = msm_kms_init_vm(mdp5_kms->dev, pdev->dev.parent);
+	vm = msm_kms_init_vm(mdp5_kms->dev, pdev->dev.parent, NULL);
 	if (IS_ERR(vm)) {
