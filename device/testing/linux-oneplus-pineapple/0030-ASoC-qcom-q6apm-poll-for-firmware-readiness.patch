-	q6apm_send_cmd_sync(apm, pkt, APM_CMD_RSP_GET_SPF_STATE);
-
-	return apm->state;
+	mutex_lock(&apm->lock);
+	apm->state = 0;
+	apm->result.opcode = 0;
+	apm->result.status = 0;
+
+	/* The audio PD can be up before APM accepts readiness queries. */
+	for (i = 0; i < 50; i++) {
+		ret = gpr_send_pkt(apm->gdev, pkt);
+		if (ret < 0)
+			break;
+
+		if (!wait_event_timeout(apm->wait,
+				apm->state == 1 || apm->result.status,
+				msecs_to_jiffies(100))) {
+			ret = -ETIMEDOUT;
+			continue;
+		}
+
+		ret = apm->result.status ? -EINVAL : apm->state;
+		break;
+	}
+	mutex_unlock(&apm->lock);
+
+	if (ret < 0)
+		dev_err(apm->dev, "APM readiness query failed: %d\n", ret);
+
+	return ret;
 }
 
