Subject: [PATCH] Start polling for clients that claim sensors during discovery

Discovering and opening SSC sensors runs nested main loops, so D-Bus clients
can claim a sensor before it has a SensorDevice. Keep those claims without
touching the unopened device, and start polling once the device is ready.
Also allocate all delayed-reply arrays before discovery can dispatch client
callbacks.

--- a/src/iio-sensor-proxy.c
+++ b/src/iio-sensor-proxy.c
@@ -423,7 +423,7 @@
 
 	g_hash_table_remove (ht, sender);
 
-	if (driver_type_exists (data, driver_type) &&
+	if (DEVICE_FOR_TYPE(driver_type) != NULL &&
 	    g_hash_table_size (ht) == 0) {
 		SensorDevice *sensor_device = DEVICE_FOR_TYPE(driver_type);
 		driver_set_polling (sensor_device, FALSE);
@@ -522,7 +522,7 @@
 							   NULL);
 		g_hash_table_insert (ht, g_strdup (sender), GUINT_TO_POINTER (watch_id));
 
-		if (driver_type_exists (data, driver_type)) {
+		if (DEVICE_FOR_TYPE(driver_type) != NULL) {
 			SensorDevice *sensor_device = DEVICE_FOR_TYPE(driver_type);
 
 			/* No other clients for this sensor? Start it */
@@ -756,6 +756,10 @@
 	SensorData *data = user_data;
 	guint i;
 
+	/* SSC discovery runs a nested main loop that can dispatch client claims. */
+	for (i = 0; i < NUM_SENSOR_TYPES; i++)
+		data->sensor_startup_dbus_invocations_delayed[i] = g_ptr_array_new ();
+
 	if (!find_sensors (data->client, data))
 		goto bail;
 
@@ -764,8 +768,6 @@
 
 	for (i = 0; i < NUM_SENSOR_TYPES; i++) {
 		SensorDevice *sensor_device;
-
-		data->sensor_startup_dbus_invocations_delayed[i] = g_ptr_array_new ();
 
 		if (!driver_type_exists (data, i))
 			continue;
@@ -779,6 +781,12 @@
 		}
 
 		DEVICE_FOR_TYPE(i) = sensor_device;
+
+		/* Honor claims received while discovering or opening the sensor. */
+		if (g_hash_table_size (data->clients[i]) > 0) {
+			data->sensor_startup_dbus_event_delayed[i] = TRUE;
+			driver_set_polling (sensor_device, TRUE);
+		}
 	}
 
 	if (!any_sensors_left (data))
